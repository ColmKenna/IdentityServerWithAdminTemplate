@page "{id}"
@model PermissionsModel
@{
    ViewData["Title"] = "Configure Client Permissions";
    ViewData["Breadcrumbs"] = new List<Breadcrumb>
    {
        new("Admin", "/Admin/Index"),
        new("Clients", "/Admin/Clients/Index"),
        new(Model.ClientNameDisplay, "/Admin/Clients/Details", new Dictionary<string, string> { { "id", Model.Id } }),
        new("Permissions")
    };
}

<page-header title="Configure Client Permissions" sub="Select which identity resources and API scopes this client may request.">
    <partial name="_BackLink" model='new BackLinkModel("./Details", "Back to Client", new Dictionary<string, string> { { "id", Model.Id } })' />
</page-header>

<form method="post" id="edit-client-permissions-form">
    <div asp-validation-summary="All" role="alert" class="validation-summary alert-panel alert-danger"></div>

    @if (Model.IsInteractive)
    {
        <ck-tabs id="client-permissions-tabs" class="client-editor-tabs">
            <ck-tab label="Identity Resources" active>
                <p class="form-text" style="margin-bottom: 14px;">These claims are returned in the ID token. <code>openid</code>
                    is required for interactive sign-in and cannot be removed.</p>

                <fieldset class="fieldset-plain">
                    <legend class="visually-hidden">Identity resources</legend>
                    <div class="scope-checkbox-grid">
                        @foreach (var scope in Model.AvailableIdentityScopes)
                        {
                            var isOpenId = scope == "openid";
                            <label class="scope-checkbox @(isOpenId ? "scope-checkbox-disabled" : null)">
                                @if (isOpenId)
                                {
                                    <input type="checkbox" checked disabled/>
                                    <input type="hidden" name="Input.AllowedScopes" value="openid"/>
                                }
                                else
                                {
                                    <input type="checkbox" name="Input.AllowedScopes" value="@scope" class="scope-checkbox"
                                           @(Model.Input.AllowedScopes.Contains(scope) ? "checked" : "")/>
                                }
                                <code>@scope</code>
                                @if (isOpenId)
                                {
                                    <span class="required" title="Required for interactive sign-in">*</span>
                                }
                            </label>
                        }
                    </div>
                </fieldset>
            </ck-tab>
            <ck-tab label="API Scopes">
                <partial name="_ScopeCheckboxGrid" model='new ScopeCheckboxGridModel(Model.AvailableApiScopes, Model.Input.AllowedScopes, "API scopes")' />
            </ck-tab>
        </ck-tabs>
    }
    else
    {
        <div class="panel panel-padded">
            <h2 class="panel-title">API Scopes</h2>
            <partial name="_ScopeCheckboxGrid" model='new ScopeCheckboxGridModel(Model.AvailableApiScopes, Model.Input.AllowedScopes, "API scopes")' />
        </div>
    }

    <div class="form-actions">
        <button type="submit" class="btn-primary">Save Changes</button>
        <a asp-page="./Details" asp-route-id="@Model.Id" class="btn-secondary">Cancel</a>
    </div>
</form>
