@model (string Name, string? CssClass)

@{
    var cssClass = Model.CssClass ?? "item-icon";
}

<svg class="@cssClass" viewBox="0 0 24 24" aria-hidden="true">
@switch (Model.Name.ToLowerInvariant())
{
    case "dashboard":
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
        break;
    case "clients":
        <rect x="2" y="4" width="20" height="13" rx="2"/>
        <line x1="8" y1="21" x2="16" y2="21"/>
        <line x1="12" y1="17" x2="12" y2="21"/>
        break;
    case "apis":
        <path d="M21 16V8l-9-5-9 5v8l9 5 9-5z"/>
        <polyline points="3.3 7.5 12 12.5 20.7 7.5"/>
        <line x1="12" y1="21" x2="12" y2="12.5"/>
        break;
    case "apiscopes":
        <circle cx="12" cy="12" r="9"/>
        <circle cx="12" cy="12" r="5"/>
        <circle cx="12" cy="12" r="1.2"/>
        break;
    case "identityresources":
        <rect x="2" y="5" width="20" height="14" rx="2"/>
        <circle cx="8" cy="11" r="2.2"/>
        <path d="M4.5 17c.4-2 1.9-3 3.5-3s3.1 1 3.5 3"/>
        <line x1="14" y1="9.5" x2="19.5" y2="9.5"/>
        <line x1="14" y1="13" x2="19.5" y2="13"/>
        break;
    case "keys":
        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
        break;
    case "users":
        <circle cx="9" cy="8" r="3.5"/>
        <path d="M2.5 20c0-3.3 2.9-5 6.5-5s6.5 1.7 6.5 5"/>
        <circle cx="17.5" cy="9" r="2.5"/>
        <path d="M16 15.3c3 .2 5.5 1.7 5.5 4.7"/>
        break;
    case "roles":
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        break;
    case "grants":
        <ellipse cx="12" cy="5.5" rx="8" ry="3"/>
        <path d="M4 5.5v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>
        <path d="M4 11.5v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>
        break;
    case "auditlogs":
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 3 14 8 19 8"/>
        <line x1="9" y1="13" x2="15" y2="13"/>
        <line x1="9" y1="17" x2="13" y2="17"/>
        break;
    case "diagnostics":
        <polyline points="2 12 7 12 10 5 14 19 17 12 22 12"/>
        break;
}
</svg>
