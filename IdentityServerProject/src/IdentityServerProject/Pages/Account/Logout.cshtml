@page
@model IdentityServerProject.Pages.Account.LogoutModel
@{
    ViewData["Title"] = Model.ShowLogoutPrompt ? "Logout" : "Logged out";
}

@if (Model.ShowLogoutPrompt)
{
    <h1>Logout</h1>
    <p>Would you like to log out of your account?</p>
    <form method="post">
        <input type="hidden" asp-for="LogoutId" />
        <button type="submit" class="btn btn-primary">Yes, Logout</button>
    </form>
}
else
{
    <h1>You have been logged out</h1>
}
