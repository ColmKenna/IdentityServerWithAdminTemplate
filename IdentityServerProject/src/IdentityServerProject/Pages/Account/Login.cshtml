@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<partial name="_AuthCardHeader" model='new AuthCardHeaderModel("AUTHENTICATION", "Welcome back", "Sign in to your account to continue")'/>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error auth-error" role="alert">
        <svg class="auth-error-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>@Model.ErrorMessage</span>
    </div>
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="auth-form" novalidate>
    <div class="form-field">
        <label asp-for="Input.Username" class="form-label">Username</label>
        <div class="input-with-icon">
            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
            <input asp-for="Input.Username" class="form-control input-has-icon" placeholder="Enter your username" autocomplete="username" autofocus aria-describedby="username-error"/>
        </div>
        <span asp-validation-for="Input.Username" id="username-error" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Input.Password" class="form-label">Password</label>
        <div class="input-with-icon">
            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <input asp-for="Input.Password" type="password" class="form-control input-has-icon" placeholder="Enter your password" autocomplete="current-password" aria-describedby="password-error"/>
        </div>
        <span asp-validation-for="Input.Password" id="password-error" class="field-validation-error"></span>
    </div>

    <button type="submit" class="btn-primary auth-submit-btn">
        <span>Sign in</span>
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
        </svg>
    </button>
</form>

<div class="auth-card-footer">
    <span class="auth-footer-text">Protected by IdentityServer authentication</span>
</div>
