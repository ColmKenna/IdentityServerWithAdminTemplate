@page
@model IndexModel
@{
    ViewData["Title"] = "Identity Resources";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Identity Resources</h1>
        <p class="page-sub">Standard OpenID Connect and custom user claim definitions</p>
    </div>
    <a asp-page="./Create" class="btn-primary">
        <svg aria-hidden="true" class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        New identity resource
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.DeleteErrorMessage))
{
    <div class="alert alert-error" role="alert">@Model.DeleteErrorMessage</div>
}

<div class="panel">
    <partial name="_ListFilter" model='new ListFilterModel("identity-resource-filter", "Filter identity resources", "Filter by name or display name", Model.Filter)' />

    <ck-responsive-table class="identity-resources-table" mobile-breakpoint="768px">
        <ck-responsive-thead>
            <ck-responsive-col-head>Name</ck-responsive-col-head>
            <ck-responsive-col-head>Display Name</ck-responsive-col-head>
            <ck-responsive-col-head>User Claims</ck-responsive-col-head>
            <ck-responsive-col-head>Referenced By</ck-responsive-col-head>
            <ck-responsive-col-head>Status</ck-responsive-col-head>
            <ck-responsive-col-head class="actions-cell">Actions</ck-responsive-col-head>
        </ck-responsive-thead>
        <ck-responsive-tbody>
            @foreach (var resource in Model.IdentityResources.Items)
            {
                <ck-responsive-row>
                    <ck-responsive-col class="resource-name">
                        <a asp-page="./Edit" asp-route-name="@resource.Name"
                           class="resource-title-link"><code>@resource.Name</code></a>
                    </ck-responsive-col>
                    <ck-responsive-col>@(string.IsNullOrWhiteSpace(resource.DisplayName) ? "—" : resource.DisplayName)</ck-responsive-col>
                    <ck-responsive-col><span
                            class="badge">@resource.UserClaimsCount claim@(resource.UserClaimsCount == 1 ? "" : "s")</span>
                    </ck-responsive-col>
                    <ck-responsive-col><span
                            class="badge">@resource.ClientReferenceCount client@(resource.ClientReferenceCount == 1 ? "" : "s")</span>
                    </ck-responsive-col>
                    <ck-responsive-col>
                        <span
                            class="status-badge @(resource.Enabled ? "enabled" : "disabled")">@(resource.Enabled ? "Enabled" : "Disabled")</span>
                    </ck-responsive-col>
                    <ck-responsive-col class="actions-cell">
                        <button
                            type="button"
                            class="action-link action-link-danger"
                            data-action="delete-resource"
                            data-delete-name="@resource.Name"
                            data-reference-count="@resource.ClientReferenceCount"
                            data-non-editable="@(resource.NonEditable || string.Equals(resource.Name, "openid", StringComparison.OrdinalIgnoreCase) ? "true" : "false")">
                            Delete
                        </button>
                    </ck-responsive-col>
                </ck-responsive-row>
            }
        </ck-responsive-tbody>
    </ck-responsive-table>

    @if (Model.IdentityResources.Items.Count == 0)
    {
        <div class="empty-state">No identity resources found.</div>
    }

    <partial name="_PaginationFooter" model='Model.IdentityResources.ToPagination("identity resources", Model.Filter)' />
</div>

<dialog id="delete-resource-modal" class="modal" aria-labelledby="delete-resource-modal-title">
    <form method="post" asp-page-handler="Delete">
        <input type="hidden" name="name" id="delete-resource-modal-name-input" value=""/>
        <input type="hidden" name="PageNumber" value="@Model.IdentityResources.PageNumber"/>
        <input type="hidden" name="Filter" value="@Model.Filter"/>

        <h2 class="modal-title" id="delete-resource-modal-title">Delete identity resource</h2>

        <p class="modal-body" id="delete-resource-modal-message" data-state="confirm">
            Are you sure you want to delete <strong id="delete-resource-modal-name-text"></strong>? This cannot be
            undone.
        </p>

        <p class="modal-body modal-body-blocked" id="delete-resource-modal-blocked-message" hidden>
            <strong id="delete-resource-modal-blocked-name-text"></strong> is currently assigned to
            <span id="delete-resource-modal-blocked-count"></span> client(s) or is a protected identity resource and
            cannot be deleted.
        </p>

        <div class="modal-actions">
            <button type="button" class="btn-secondary" data-action="close-modal">Cancel</button>
            <button type="submit" id="delete-resource-modal-confirm" class="btn-danger">Delete</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/identity-resource-list.js" asp-append-version="true"></script>
}
