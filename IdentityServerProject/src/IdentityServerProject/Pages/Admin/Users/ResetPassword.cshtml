@page "{id}"
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Admin", "/Admin/Index"),
        ("Users", "/Admin/Users"),
        (Model.UserNameDisplay, $"/Admin/Users/Details/{Model.Id}"),
        ("Reset Password", null)
    };
}

<page-header title="Reset Password" sub="Set a new password for @Model.UserNameDisplay.">
</page-header>

<form method="post">
    <div asp-validation-summary="All" role="alert" class="validation-summary alert-panel alert-danger"></div>

    <div class="panel panel-padded">
        <div class="form-field">
            <label asp-for="Input.NewPassword" class="form-label">New Password</label>
            <input asp-for="Input.NewPassword" type="password" class="form-control" autocomplete="new-password"/>
            <span asp-validation-for="Input.NewPassword" class="text-danger field-validation-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password"/>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger field-validation-error"></span>
        </div>

        <div class="form-actions form-actions-spaced">
            <button type="submit" class="btn-danger">Reset Password</button>
            <a asp-page="./Details" asp-route-id="@Model.Id" class="btn-secondary">Cancel</a>
        </div>
    </div>
</form>
