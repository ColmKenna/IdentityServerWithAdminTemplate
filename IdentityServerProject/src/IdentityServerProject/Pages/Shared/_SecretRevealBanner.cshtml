@model IdentityServerProject.Pages.Shared.SecretRevealBannerModel

@if (!string.IsNullOrEmpty(Model.SecretValue))
{
    <div id="secret-reveal-banner" class="panel alert-panel alert-success secret-reveal-banner">
        <h2 class="secret-reveal-title">🔑 Client Secret Generated</h2>
        <p class="secret-reveal-description">
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                @SafeMarkupBody.Render(Model.Description, Model.DescriptionArgs, HtmlEncoder)
            }
            else
            {
                <text>Client <strong><code>@Model.ClientId</code></strong> has been created successfully. Below is the one-time client secret.</text>
            }
        </p>
        <div class="secret-reveal-controls">
            <label class="visually-hidden" for="generated-secret-input">Generated client secret</label>
            <input id="generated-secret-input" type="text" class="form-control secret-reveal-value"
                   value="@Model.SecretValue" readonly/>
            <button id="copy-secret-btn" type="button" class="btn-primary" data-copy-target="generated-secret-input" onclick="copySecretToClipboard()">Copy Secret</button>
        </div>
        <p class="secret-reveal-warning">
            ⚠️ <strong>Important:</strong> Copy this secret now. It is stored securely in hashed format and cannot be displayed again!
        </p>
    </div>
}
