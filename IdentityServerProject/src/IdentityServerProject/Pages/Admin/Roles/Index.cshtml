@page
@model IndexModel
@{
    ViewData["Title"] = "Roles";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Admin", "/Admin/Index"),
        ("Roles", null)
    };
}

<page-header title="Roles" sub="Manage identity roles and user assignments">
    <a id="new-role-link" class="btn-primary" asp-page="./Create">
        <partial name="_AdminIcon" model='("plus", "btn-icon")' />
        New Role
    </a>
</page-header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
}

<div class="panel">
    <div class="panel-toolbar">
        <partial name="_ListFilter" model='new ListFilterModel("role-filter", "Filter roles", "Search roles...", Model.Filter)' />
    </div>

    @if (Model.Roles.Items.Count == 0)
    {
        <div class="empty-state">
            @if (!string.IsNullOrWhiteSpace(Model.Filter))
            {
                <p>No roles found matching "@Model.Filter".</p>
            }
            else
            {
                <p>No roles have been created yet.</p>
            }
        </div>
    }
    else
    {
        <ck-responsive-table class="roles-table" mobile-breakpoint="768px">
            <ck-responsive-thead>
                <ck-responsive-col-head>Role Name</ck-responsive-col-head>
                <ck-responsive-col-head class="actions-cell">Actions</ck-responsive-col-head>
            </ck-responsive-thead>
            <ck-responsive-tbody>
                @foreach (var item in Model.Roles.Items)
                {
                    <ck-responsive-row>
                        <ck-responsive-col>
                            <strong>@item.Name</strong>
                            @if (item.IsProtected)
                            {
                                <span class="badge badge-reserved" style="margin-left: 8px;"
                                      title="This role is protected and cannot be deleted.">Protected</span>
                            }
                        </ck-responsive-col>
                        <ck-responsive-col class="actions-cell">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id"
                                  style="display:inline;">
                                <button type="submit" class="btn-sm btn-secondary text-danger"
                                        disabled="@item.IsProtected"
                                        title="@(item.IsProtected ? "Cannot delete a protected role." : "Delete role")"
                                        onclick="return confirm('Are you sure you want to delete this role?');">Delete
                                </button>
                            </form>
                        </ck-responsive-col>
                    </ck-responsive-row>
                }
            </ck-responsive-tbody>
        </ck-responsive-table>
    }

    <partial name="_PaginationFooter" model='Model.Roles.ToPagination("roles", Model.Filter)' />
</div>
