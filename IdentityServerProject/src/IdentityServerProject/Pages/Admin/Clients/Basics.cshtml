@page "{id}"
@model BasicsModel
@{
    ViewData["Title"] = "Edit Client Basics";
    ViewData["Breadcrumbs"] = new List<Breadcrumb>
    {
        new("Admin", "/Admin/Index"),
        new("Clients", "/Admin/Clients/Index"),
        new(Model.Input.ClientName ?? Model.Id, "/Admin/Clients/Details", new Dictionary<string, string> { { "id", Model.Id } }),
        new("Basics")
    };
}

<page-header title="Edit Client Basics" sub="Configure the basic identity and description details for this client application.">
    <partial name="_BackLink" model='new BackLinkModel("./Details", "Back to Client", new Dictionary<string, string> { { "id", Model.Id } })' />
</page-header>

<form method="post" id="edit-client-basics-form">
    <div asp-validation-summary="All" role="alert" class="validation-summary alert-panel alert-danger"></div>

    <div class="panel panel-padded">
        <h2 class="panel-title">Client Basics</h2>

        <div class="form-field">
            <label class="form-label" for="client-id">Client ID</label>
            <input type="text" id="client-id" class="form-control" value="@Model.ClientIdDisplay" disabled/>
            <small class="form-text">The unique identifier for this client. This cannot be changed.</small>
        </div>

        <div class="form-field">
            <label asp-for="Input.ClientName" class="form-label">Client Display Name <span
                    class="required">*</span></label>
            <input asp-for="Input.ClientName" class="form-control" placeholder="e.g. Customer Portal Web" required/>
            <span asp-validation-for="Input.ClientName" class="text-danger field-validation-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.Description" class="form-label">Description</label>
            <textarea asp-for="Input.Description" class="form-control" rows="4"
                      placeholder="Optional notes about this client application"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger field-validation-error"></span>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn-primary">Save Changes</button>
        <a asp-page="./Details" asp-route-id="@Model.Id" class="btn-secondary">Cancel</a>
    </div>
</form>
