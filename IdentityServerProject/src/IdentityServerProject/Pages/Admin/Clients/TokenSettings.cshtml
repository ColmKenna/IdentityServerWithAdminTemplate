@page "{id}"
@model TokenSettingsModel
@{
    ViewData["Title"] = "Configure Client Token Settings";
    ViewData[AdminComponents.ViewDataKey] = AdminComponent.Tabs;
    ViewData["Breadcrumbs"] = new List<Breadcrumb>
    {
        new("Admin", "/Admin/Index"),
        new("Clients", "/Admin/Clients/Index"),
        new(Model.ClientNameDisplay, "/Admin/Clients/Details", new Dictionary<string, string> { { "id", Model.Id } }),
        new("Token Settings")
    };
}

<page-header title="Configure Client Token Settings" sub="Set token lifetimes and consent/offline-access behavior for this client.">
    <partial name="_BackLink" model='new BackLinkModel("./Details", "Back to Client", new Dictionary<string, string> { { "id", Model.Id } })' />
</page-header>

<form method="post" id="edit-client-token-settings-form">
    <div asp-validation-summary="All" class="validation-summary alert-panel alert-danger" role="alert"></div>

    <ck-tabs id="client-token-settings-tabs" class="client-editor-tabs">
        <ck-tab label="Token Lifetimes" active="@(Model.ActiveTabIndex == 0 ? "active" : null)">
            <div class="form-field">
                <label asp-for="Input.AccessTokenLifetime" class="form-label">Access Token Lifetime (seconds)</label>
                <input asp-for="Input.AccessTokenLifetime" type="number" min="60" max="86400" class="form-control" aria-describedby="access-token-lifetime-error"/>
                <span asp-validation-for="Input.AccessTokenLifetime" id="access-token-lifetime-error" class="text-danger field-validation-error"></span>
                <small class="form-text">Between 60 and 86400 seconds (1 minute to 24 hours).</small>
            </div>

            <div class="form-field">
                <label asp-for="Input.IdentityTokenLifetime" class="form-label">Identity Token Lifetime
                    (seconds)</label>
                <input asp-for="Input.IdentityTokenLifetime" type="number" min="60" max="3600" class="form-control" aria-describedby="identity-token-lifetime-error"/>
                <span asp-validation-for="Input.IdentityTokenLifetime" id="identity-token-lifetime-error"
                      class="text-danger field-validation-error"></span>
                <small class="form-text">Between 60 and 3600 seconds (1 minute to 1 hour).</small>
            </div>
        </ck-tab>
        <ck-tab label="Consent &amp; Offline Access" active="@(Model.ActiveTabIndex == 1 ? "active" : null)">
            <div class="form-option-row">
                <label class="checkbox-label">
                    <input type="checkbox" asp-for="Input.RequireConsent"/>
                    <span>Require Consent</span>
                </label>

                <label class="checkbox-label">
                    <input type="checkbox" asp-for="Input.AllowOfflineAccess" id="allow-offline-access"/>
                    <span>Allow Offline Access (Refresh Tokens)</span>
                </label>
            </div>

            <div id="refresh-token-settings" class="refresh-token-settings">
                <h3 class="subsection-heading">Refresh Token Policies</h3>

                <div class="form-field">
                    <label asp-for="Input.RefreshTokenUsage" class="form-label">Refresh Token Usage</label>
                    <select asp-for="Input.RefreshTokenUsage" class="form-control">
                        <option value="0">ReUse (0)</option>
                        <option value="1">OneTime (1)</option>
                    </select>
                    <small class="form-text">ReUse: the refresh token handle will stay the same when refreshing tokens.</small>
                    <small class="form-text">OneTime: the refresh token handle will be updated when refreshing tokens.</small>
                </div>

                <div class="form-field">
                    <label asp-for="Input.RefreshTokenExpiration" class="form-label">Refresh Token Expiration</label>
                    <select asp-for="Input.RefreshTokenExpiration" class="form-control">
                        <option value="0">Sliding (0)</option>
                        <option value="1">Absolute (1)</option>
                    </select>
                    <small class="form-text">Absolute: the refresh token will expire on a fixed point in time.</small>
                    <small class="form-text">Sliding: when refreshing the token, the lifetime of the refresh token will be renewed.</small>
                </div>

                <div class="form-field">
                    <label asp-for="Input.AbsoluteRefreshTokenLifetime" class="form-label">Absolute Refresh Token
                        Lifetime (seconds)</label>
                    <input asp-for="Input.AbsoluteRefreshTokenLifetime" type="number" min="60" max="31536000"
                           class="form-control" aria-describedby="absolute-refresh-token-lifetime-error"/>
                    <span asp-validation-for="Input.AbsoluteRefreshTokenLifetime" id="absolute-refresh-token-lifetime-error"
                          class="text-danger field-validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Input.SlidingRefreshTokenLifetime" class="form-label">Sliding Refresh Token Lifetime
                        (seconds)</label>
                    <input asp-for="Input.SlidingRefreshTokenLifetime" type="number" min="60" max="15552000"
                           class="form-control" aria-describedby="sliding-refresh-token-lifetime-error"/>
                    <span asp-validation-for="Input.SlidingRefreshTokenLifetime" id="sliding-refresh-token-lifetime-error"
                          class="text-danger field-validation-error"></span>
                </div>
            </div>
        </ck-tab>
    </ck-tabs>

    <div class="form-actions">
        <button type="submit" class="btn-primary">Save Changes</button>
        <a asp-page="./Details" asp-route-id="@Model.Id" class="btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/client-token-settings.js" asp-append-version="true"></script>
}
