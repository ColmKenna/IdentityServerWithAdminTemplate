@using IdentityServerProject
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    // Route-prefix match on Razor Pages route data, not the page title (titles vary per
    // sub-page, e.g. a client's own name) and not a hardcoded single-section special case.
    // Matched on path segment boundaries so "/Admin/Apis" doesn't false-positive against
    // "/Admin/ApiScopes" (a plain StartsWith would incorrectly match both).
    string GetNavItemClass(string sectionPrefix)
    {
        var isActive = !string.IsNullOrEmpty(currentPage) &&
            (currentPage.Equals(sectionPrefix, StringComparison.OrdinalIgnoreCase) ||
             currentPage.StartsWith(sectionPrefix + "/", StringComparison.OrdinalIgnoreCase));

        return isActive ? "nav-item active" : "nav-item";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "Admin Console") - IdentityServer</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script>
        (function() {
            try {
                if (localStorage.getItem('admin_sidebar_collapsed') === 'true') {
                    document.documentElement.classList.add('sidebar-collapsed-preload');
                }
            } catch (e) {}
        })();
    </script>
</head>
<body>
<script>
    (function() {
        try {
            if (localStorage.getItem('admin_sidebar_collapsed') === 'true') {
                document.body.classList.add('collapsed');
            }
        } catch (e) {}
    })();
</script>

<!-- ===== Sidebar ===== -->
@if (User.IsInRole(Config.SysAdminRole))
{
<aside class="sidebar" id="sidebar">
  <a asp-page="/Admin/Index" class="brand" style="text-decoration:none; color:inherit;">
    <div class="brand-icon">id</div>
    <div class="brand-text label">
      <div class="brand-name">IdentityServer</div>
      <div class="brand-sub">ADMIN CONSOLE</div>
    </div>
  </a>

  <div class="sidebar-scroll">
    <div class="section-label"><span class="label">Configure</span></div>

    <a asp-page="/Admin/Clients/Index" class="@GetNavItemClass("/Admin/Clients")" data-tip="Clients"><svg class="item-icon" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="13" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg><span class="label">Clients</span></a>
    <a asp-page="/Admin/Apis/Index" class="@GetNavItemClass("/Admin/Apis")" data-tip="API Resources"><svg class="item-icon" viewBox="0 0 24 24"><path d="M21 16V8l-9-5-9 5v8l9 5 9-5z"/><polyline points="3.3 7.5 12 12.5 20.7 7.5"/><line x1="12" y1="21" x2="12" y2="12.5"/></svg><span class="label">API Resources</span></a>
    <a asp-page="/Admin/ApiScopes/Index" class="@GetNavItemClass("/Admin/ApiScopes")" data-tip="API Scopes"><svg class="item-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/></svg><span class="label">API Scopes</span></a>
    <a asp-page="/Admin/IdentityResources/Index" class="@GetNavItemClass("/Admin/IdentityResources")" data-tip="Identity Resources"><svg class="item-icon" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="8" cy="11" r="2.2"/><path d="M4.5 17c.4-2 1.9-3 3.5-3s3.1 1 3.5 3"/><line x1="14" y1="9.5" x2="19.5" y2="9.5"/><line x1="14" y1="13" x2="19.5" y2="13"/></svg><span class="label">Identity Resources</span></a>
    <a asp-page="/Admin/Keys/Index" class="@GetNavItemClass("/Admin/Keys")" data-tip="Signing Keys"><svg class="item-icon" viewBox="0 0 24 24"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg><span class="label">Signing Keys</span></a>

    <div class="section-label"><span class="label">Administer</span></div>

    <a asp-page="/Admin/Users/Index" class="@GetNavItemClass("/Admin/Users")" data-tip="Users"><svg class="item-icon" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.3 2.9-5 6.5-5s6.5 1.7 6.5 5"/><circle cx="17.5" cy="9" r="2.5"/><path d="M16 15.3c3 .2 5.5 1.7 5.5 4.7"/></svg><span class="label">Users</span></a>
    <a asp-page="/Admin/Roles/Index" class="@GetNavItemClass("/Admin/Roles")" data-tip="Roles"><svg class="item-icon" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span class="label">Roles</span></a>
    <a asp-page="/Admin/Grants/Index" class="@GetNavItemClass("/Admin/Grants")" data-tip="Persisted Grants"><svg class="item-icon" viewBox="0 0 24 24"><ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M4 5.5v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/><path d="M4 11.5v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg><span class="label">Persisted Grants</span></a>
    <a asp-page="/Admin/AuditLogs/Index" class="@GetNavItemClass("/Admin/AuditLogs")" data-tip="Audit Log"><svg class="item-icon" viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><polyline points="14 3 14 8 19 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg><span class="label">Audit Log</span></a>
    <a asp-page="/Admin/Diagnostics/Index" class="@GetNavItemClass("/Admin/Diagnostics")" data-tip="Diagnostics"><svg class="item-icon" viewBox="0 0 24 24"><polyline points="2 12 7 12 10 5 14 19 17 12 22 12"/></svg><span class="label">Diagnostics</span></a>
  </div>

  <div class="side-user" data-tip="@(User.Identity?.Name ?? "sysadmin")">
    <div class="side-avatar">@(string.IsNullOrWhiteSpace(User.Identity?.Name) ? "S" : User.Identity.Name.Substring(0, 1).ToUpper())</div>
    <span class="name label">@(User.Identity?.Name ?? "sysadmin")</span>
  </div>
</aside>
}

<!-- ===== Header ===== -->
<header class="header">
  <button class="burger" id="burger" aria-label="Toggle sidebar">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>

  <nav class="crumbs" id="crumbs" aria-label="Breadcrumb">
    @if (IsSectionDefined("Breadcrumbs"))
    {
        @await RenderSectionAsync("Breadcrumbs", required: false)
    }
    else if ((ViewData["BreadcrumbItems"] ?? ViewData["Breadcrumbs"]) is IEnumerable<(string Text, string? Url)> crumbsList)
    {
        var crumbs = crumbsList.ToList();
        for (int i = 0; i < crumbs.Count; i++)
        {
            var item = crumbs[i];
            if (i > 0)
            {
                <span class="sep">/</span>
            }

            if (!string.IsNullOrEmpty(item.Url) && i < crumbs.Count - 1)
            {
                <a href="@item.Url">@item.Text</a>
            }
            else
            {
                <span class="current">@item.Text</span>
            }
        }
    }
    else
    {
        <a asp-page="/Admin/Clients/Index">Admin</a>
        <span class="sep">/</span>
        <span class="current">@(ViewData["Title"] ?? "Clients")</span>
    }
  </nav>

  <div class="spacer"></div>

  @* Settings navigation is intentionally omitted until a real destination exists.
    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1-1.55 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09a1.7 1.7 0 0 0 1.55-1 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34h.01a1.7 1.7 0 0 0 1-1.55V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87v.01a1.7 1.7 0 0 0 1.55 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1z"/></svg>
  *@

  <div class="user-menu" id="userMenu">
    @if (User.Identity?.IsAuthenticated == true)
    {
      <button class="user-btn" id="userBtn" aria-haspopup="true" aria-expanded="false">
        <span class="avatar">@(User.Identity.Name?.Substring(0, Math.Min(2, User.Identity.Name.Length)).ToUpper() ?? "AD")</span>
        <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="dropdown" role="menu">
        <form method="post" asp-page="/Account/Logout" class="logout-form" style="display:inline;">
          <button type="submit" class="logout" style="background:none; border:none; width:100%; text-align:left; cursor:pointer;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>Sign Out</button>
        </form>
      </div>
    }
    else
    {
      <a asp-page="/Account/Login" class="btn-login">Sign In</a>
    }
  </div>
</header>

<!-- ===== Main ===== -->
<main class="main">
    @RenderBody()
</main>

<script type="module" src="~/lib/ck-responsive-table-webcomponent/index.esm.js" asp-append-version="true"></script>
<script type="module" src="~/lib/ck-tabs-webcomponent/index.esm.js" asp-append-version="true"></script>
<script src="~/js/admin.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
