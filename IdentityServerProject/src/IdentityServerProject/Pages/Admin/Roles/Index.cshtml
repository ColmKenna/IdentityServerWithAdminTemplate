@page
@model IndexModel
@{
    ViewData["Title"] = "Roles";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Admin", "/Admin/Index"),
        ("Roles", null)
    };
}

<div class="page-header">
    <h1 class="page-title">Roles</h1>
    <a asp-page="./Create" class="btn-primary">New Role</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
}

<div class="panel">
    <div class="panel-toolbar"
         style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 20px;">
        <form method="get" class="list-filter" role="search" style="display: flex; gap: 10px;">
            <label class="visually-hidden" for="role-filter">Filter roles</label>
            <input type="text" asp-for="Filter" id="role-filter" class="form-control" placeholder="Search roles..."
                   style="width: 250px;"/>
            <button type="submit" class="btn-secondary">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.Filter))
            {
                <a asp-page="./Index" class="btn-tertiary">Clear</a>
            }
        </form>
    </div>

    @if (Model.Roles.Items.Count == 0)
    {
        <div class="empty-state">
            @if (!string.IsNullOrWhiteSpace(Model.Filter))
            {
                <p>No roles found matching "@Model.Filter".</p>
            }
            else
            {
                <p>No roles have been created yet.</p>
            }
        </div>
    }
    else
    {
        <ck-responsive-table class="roles-table" mobile-breakpoint="768px">
            <ck-responsive-thead>
                <ck-responsive-col-head>Role Name</ck-responsive-col-head>
                <ck-responsive-col-head class="actions-cell">Actions</ck-responsive-col-head>
            </ck-responsive-thead>
            <ck-responsive-tbody>
                @foreach (var item in Model.Roles.Items)
                {
                    <ck-responsive-row>
                        <ck-responsive-col>
                            <strong>@item.Name</strong>
                            @if (item.IsProtected)
                            {
                                <span class="badge badge-reserved" style="margin-left: 8px;"
                                      title="This role is protected and cannot be deleted.">Protected</span>
                            }
                        </ck-responsive-col>
                        <ck-responsive-col class="actions-cell">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id"
                                  style="display:inline;">
                                <button type="submit" class="btn-sm btn-secondary text-danger"
                                        disabled="@item.IsProtected"
                                        title="@(item.IsProtected ? "Cannot delete a protected role." : "Delete role")"
                                        onclick="return confirm('Are you sure you want to delete this role?');">Delete
                                </button>
                            </form>
                        </ck-responsive-col>
                    </ck-responsive-row>
                }
            </ck-responsive-tbody>
        </ck-responsive-table>
    }

    <partial name="_PaginationFooter" model='Model.Roles.ToPagination("roles", Model.Filter)' />
</div>

<style>
    .form-control {
        border: 1px solid var(--border, #e6e8eb);
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 0.9rem;
    }

    .badge-reserved {
        background: var(--danger-soft, #fdecec);
        color: var(--danger, #b3261e);
        border: 1px solid var(--danger, #b3261e);
        border-radius: 999px;
        padding: 1px 8px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .text-danger {
        color: var(--danger, #b3261e);
    }
</style>
