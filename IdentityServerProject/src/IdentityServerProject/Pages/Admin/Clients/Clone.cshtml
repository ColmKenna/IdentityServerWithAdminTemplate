@page "{sourceClientId}"
@model CloneModel
@{
    ViewData["Title"] = "Clone Client";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Admin", "/Admin/Index"),
        ("Clients", "/Admin/Clients"),
        (Model.SourceClientName, $"/Admin/Clients/Details/{Model.SourceClientId}"),
        ("Clone", null)
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">Clone Client</h1>
        <p class="page-sub">Create a new client based on <strong>@Model.SourceClientName</strong>. The new client will
            inherit all settings and scopes, except for the client secrets.</p>
    </div>
    <partial name="_BackLink" model='new BackLinkModel("./Details", "Back to Client", new Dictionary<string, string> { { "id", Model.SourceClientId } })' />
</div>

<form method="post" id="clone-client-form">
    <div asp-validation-summary="All" class="validation-summary alert-panel alert-danger"
         style="display: @(ViewData.ModelState.IsValid ? "none" : "block"); margin-bottom: 20px;"></div>

    <input type="hidden" asp-for="SourceClientId"/>

    <div class="panel" style="margin-bottom: 24px; padding: 28px;">
        <div class="form-group" style="margin-bottom: 16px;">
            <label asp-for="Input.ClientId" class="form-label">New Client ID <span class="required">*</span></label>
            <input asp-for="Input.ClientId" class="form-control" placeholder="e.g. my-web-app-clone" required/>
            <span asp-validation-for="Input.ClientId" class="text-danger field-validation-error"></span>
            <small class="form-text text-muted" style="display: block; margin-top: 4px; font-size: 0.85rem;">Unique
                alphanumeric identifier used in OAuth requests.</small>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label asp-for="Input.ClientName" class="form-label">New Client Display Name <span class="required">*</span></label>
            <input asp-for="Input.ClientName" class="form-control" placeholder="e.g. Customer Portal Web Clone"
                   required/>
            <span asp-validation-for="Input.ClientName" class="text-danger field-validation-error"></span>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label asp-for="Input.Description" class="form-label">Description</label>
            <textarea asp-for="Input.Description" class="form-control" rows="2"
                      placeholder="Optional notes about this client application"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger field-validation-error"></span>
        </div>

        <div class="form-actions" style="margin-top: 24px;">
            <button type="submit" class="btn-primary">Clone Client</button>
            <a asp-page="./Details" asp-route-id="@Model.SourceClientId" class="btn-secondary">Cancel</a>
        </div>
    </div>
</form>
