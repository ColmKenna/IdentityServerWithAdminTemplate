@page
@using Microsoft.IdentityModel.Tokens
@model IndexModel
@{
    ViewData["Title"] = "Keys";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Admin", "/Admin/Index"),
        ("Keys", null)
    };
}

<div class="page-header">
    <h1 class="page-title">Signing Keys</h1>
</div>

<div class="panel">
    <h2 class="panel-title" style="margin-bottom: 20px;">Key Material</h2>
    <p class="text-muted" style="margin-bottom: 20px;">
        IdentityServer manages its own key rotation. Here are the current signing keys in the system.
    </p>

    @if (Model.Keys.Count == 0)
    {
        <div class="empty-state">No keys found in the system.</div>
    }
    else
    {
        <ck-responsive-table class="keys-table" mobile-breakpoint="768px">
            <ck-responsive-thead>
                <ck-responsive-col-head>ID / Thumbprint</ck-responsive-col-head>
                <ck-responsive-col-head>Algorithm</ck-responsive-col-head>
                <ck-responsive-col-head>Created</ck-responsive-col-head>
                <ck-responsive-col-head>Status</ck-responsive-col-head>
            </ck-responsive-thead>
            <ck-responsive-tbody>
                @foreach (var key in Model.Keys)
                {
                    <ck-responsive-row>
                        <ck-responsive-col>
                            <code>@key.Key.KeyId</code>
                        </ck-responsive-col>
                        <ck-responsive-col>@key.SigningAlgorithm</ck-responsive-col>
                        <ck-responsive-col>—</ck-responsive-col>
                        <ck-responsive-col>
                            @if (key.Key is X509SecurityKey)
                            {
                                <span class="badge badge-success">X509 Certificate</span>
                            }
                            else
                            {
                                <span class="badge badge-primary">Asymmetric Key</span>
                            }
                        </ck-responsive-col>
                    </ck-responsive-row>
                }
            </ck-responsive-tbody>
        </ck-responsive-table>
    }
</div>

<style>
    .badge-success {
        background: #e6f4ea;
        color: #1e8e3e;
        border: 1px solid #1e8e3e;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .badge-primary {
        background: #e8f0fe;
        color: #1a73e8;
        border: 1px solid #1a73e8;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 0.75rem;
        font-weight: 700;
    }
</style>
