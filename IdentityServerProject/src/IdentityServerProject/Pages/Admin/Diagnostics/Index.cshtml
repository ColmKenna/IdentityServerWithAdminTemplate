@page
@model IdentityServerProject.Pages.Admin.Diagnostics.IndexModel
@{
    ViewData["Title"] = "Diagnostics";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Diagnostics</h1>
        <p class="page-sub">Read-only view of IdentityServer store health, active signing credentials, and reserved-claim exposure.</p>
    </div>
</div>

<div class="panel" style="margin-bottom: 24px; padding: 28px;">
    <h2 class="panel-title" style="font-size: 1.1rem; margin-bottom: 16px; font-weight: 700;">Store Health</h2>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;">
        @foreach (var store in Model.Diagnostics.StoreHealth)
        {
            <div class="panel" id="store-health-@store.Name.Replace(" ", "-").ToLowerInvariant()" style="padding: 16px; border: 1px solid var(--line-soft, #dde3e8);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <strong>@store.Name</strong>
                    <span class="status-badge @(store.IsHealthy ? "enabled" : "disabled")">@(store.IsHealthy ? "Healthy" : "Degraded")</span>
                </div>
                <div class="text-muted" style="font-size: 0.85rem;">@store.Detail</div>
            </div>
        }
    </div>
</div>

<div class="panel" style="margin-bottom: 24px; padding: 28px;">
    <h2 class="panel-title" style="font-size: 1.1rem; margin-bottom: 6px; font-weight: 700;">Reserved User Claims</h2>
    <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 16px;">
        User claims whose type the framework owns. These are copied onto the sign-in principal verbatim,
        so a role-typed one grants privilege that the Roles tab and the last-administrator check cannot see.
        Remove them from the user's Claims tab.
    </p>

    @if (Model.Diagnostics.ReservedClaimHolders.Count == 0)
    {
        <div class="empty-state" id="reserved-claims-empty">No users hold a reserved claim type.</div>
    }
    else
    {
        <ul style="list-style: none; padding: 0;" id="reserved-claim-holders">
            @foreach (var holder in Model.Diagnostics.ReservedClaimHolders)
            {
                <li style="display: flex; gap: 12px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--line-soft, #eef1f3);">
                    <a asp-page="/Admin/Users/Details" asp-route-id="@holder.UserId" asp-route-tab="claims">@holder.UserName</a>
                    <code>@holder.ClaimType</code> = <code>@holder.ClaimValue</code>
                </li>
            }
        </ul>
    }
</div>

<div class="panel" style="padding: 28px;">
    <h2 class="panel-title" style="font-size: 1.1rem; margin-bottom: 16px; font-weight: 700;">Signing Credentials</h2>

    <div class="field-group" style="display: flex; gap: 8px; padding: 8px 0; border-bottom: 1px solid var(--line-soft, #eef1f3);">
        <span class="field-label" style="font-weight: 600; min-width: 140px; color: var(--text-dim, #8b9096);">Active Key ID:</span>
        <code id="active-signing-key-id">@(Model.Diagnostics.SigningKeyId ?? "—")</code>
    </div>
    <div class="field-group" style="display: flex; gap: 8px; padding: 8px 0; border-bottom: 1px solid var(--line-soft, #eef1f3);">
        <span class="field-label" style="font-weight: 600; min-width: 140px; color: var(--text-dim, #8b9096);">Algorithm:</span>
        <code>@(Model.Diagnostics.SigningAlgorithm ?? "—")</code>
    </div>

    <h3 style="font-size: 0.95rem; margin: 20px 0 10px; font-weight: 700;">Active Validation Keys</h3>
    @if (Model.Diagnostics.ActiveValidationKeys.Count == 0)
    {
        <div class="empty-state">No active validation keys found.</div>
    }
    else
    {
        <ul style="list-style: none; padding: 0;" id="active-validation-keys">
            @foreach (var key in Model.Diagnostics.ActiveValidationKeys)
            {
                <li style="display: flex; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line-soft, #eef1f3);">
                    <code>@key.KeyId</code>
                    <span class="text-muted">@key.Algorithm</span>
                    @if (key.IsX509Certificate)
                    {
                        <span class="badge">X.509</span>
                    }
                </li>
            }
        </ul>
    }
</div>
