@model IdentityServerProject.Pages.Admin.Clients.ClientEditorTabsModel
@*
    Sub-navigation strip shared by the five Client editor pages (WI-07).

    Each tab is a link to a sibling page rather than an in-page panel, so the ck-tabs component
    is used for the *strip* only: wwwroot/js/client-editor-tabs.js suppresses the component's
    panels and turns a tab selection into a navigation. The <a> inside each <ck-tab> is what the
    script navigates to, and it is also the pre-upgrade / no-JavaScript fallback — see the
    .client-editor-nav:not(:defined) rules in admin.css.
*@
<nav aria-label="Client editor sections">
    <ck-tabs class="client-editor-nav" data-client-editor-nav>
        @foreach (var tab in ClientEditorTabsModel.Tabs)
        {
            var isCurrent = tab.Tab == Model.CurrentTab;
            @* data-current is written out for every tab: Razor's null-attribute suppression
               does not apply to data-* attributes, so it carries an explicit true/false. *@
            <ck-tab label="@tab.Label"
                    active="@(isCurrent ? "" : null)"
                    data-current="@(isCurrent ? "true" : "false")">
                <a asp-page="@tab.Page" asp-route-id="@Model.ClientId" aria-current="@(isCurrent ? "page" : null)">@tab.Label</a>
            </ck-tab>
        }
    </ck-tabs>
</nav>

<script type="module" src="~/js/client-editor-tabs.js" asp-append-version="true"></script>
