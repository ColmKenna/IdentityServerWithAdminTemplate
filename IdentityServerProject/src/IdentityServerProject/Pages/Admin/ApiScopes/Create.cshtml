@page
@model IdentityServerProject.Pages.Admin.ApiScopes.CreateModel
@{
    ViewData["Title"] = "Create API Scope";
}

<div class="editor-header">
    <div>
        <h1 class="hero-title">Create API Scope</h1>
        <p class="page-sub">Add a new API scope that clients can request access to.</p>
    </div>
    <a asp-page="./Index" class="back-link">
        <svg class="back-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to list
    </a>
</div>

<div class="panel editor-panel">
    <form method="post" class="editor-form">
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="form-field">
            <label class="form-label" for="scope-name">Scope Name *</label>
            <input class="form-control" id="scope-name" asp-for="Input.Name" />
            <span asp-validation-for="Input.Name" class="field-validation-error"></span>
            <small class="form-text">A unique identifier for this scope (e.g., 'api.read', 'api.write'). This cannot be changed after creation.</small>
        </div>

        <div class="form-field">
            <label class="form-label" for="scope-display-name">Display Name</label>
            <input class="form-control" id="scope-display-name" asp-for="Input.DisplayName" />
            <span asp-validation-for="Input.DisplayName" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label class="form-label" for="scope-description">Description</label>
            <textarea class="form-control" id="scope-description" rows="3" asp-for="Input.Description"></textarea>
            <span asp-validation-for="Input.Description" class="field-validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Create Scope</button>
        </div>
    </form>
</div>
