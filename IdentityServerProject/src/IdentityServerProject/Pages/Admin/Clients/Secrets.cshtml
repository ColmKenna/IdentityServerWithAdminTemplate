@page "{id}"
@model SecretsModel
@{
    ViewData["Title"] = "Manage Client Secrets";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Admin", "/Admin/Index"),
        ("Clients", "/Admin/Clients/Index"),
        (Model.Client.ClientName, $"/Admin/Clients/Details/{Model.Id}"),
        ("Secrets", null)
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">Manage Client Secrets</h1>
        <p class="page-sub">List, generate, and revoke credentials this client uses to authenticate.</p>
    </div>
    <a asp-page="./Details" asp-route-id="@Model.Id" class="btn-secondary">&larr; Back to Client</a>
</div>

@if (Model.RevealMode)
{
    <div id="secret-reveal-banner" class="panel alert-panel alert-success"
         style="border-left: 5px solid #278070; background: #e8f8f5; padding: 20px; margin-bottom: 24px;">
        <h2 style="font-size: 18px; margin-bottom: 8px; color: #16324f;">🔑 Client Secret Generated</h2>
        <p style="margin-bottom: 12px; font-size: 14px;">
            A new secret has been generated for <strong><code>@Model.Id</code></strong>. Below is the one-time value.
        </p>
        <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 12px;">
            <input id="generated-secret-input" type="text" class="form-control" value="@Model.GeneratedSecret" readonly
                   style="font-family: monospace; font-size: 16px; font-weight: bold; background: #fff; max-width: 450px;"/>
            <button id="copy-secret-btn" type="button" class="btn-primary" onclick="copySecretToClipboard()">Copy
                Secret
            </button>
        </div>
        <p class="text-danger" style="margin: 0; font-weight: 500; font-size: 13px; color: #a94442;">
            ⚠️ <strong>Important:</strong> Copy this secret now. It is stored securely in hashed format and cannot be
            displayed again!
        </p>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.RevokeErrorMessage))
{
    <div class="alert alert-error" role="alert">@Model.RevokeErrorMessage</div>
}

<ck-tabs id="client-secrets-tabs" class="client-editor-tabs">
    <ck-tab label="Active Secrets" active>
        @if (Model.Client.Secrets.Count == 0)
        {
            <div class="empty-state">No secrets registered for this client.</div>
        }
        else
        {
            <ck-responsive-table class="client-secrets-table" mobile-breakpoint="768px">
                <ck-responsive-thead>
                    <ck-responsive-col-head>Description</ck-responsive-col-head>
                    <ck-responsive-col-head>Created</ck-responsive-col-head>
                    <ck-responsive-col-head>Expiration</ck-responsive-col-head>
                    <ck-responsive-col-head class="actions-cell">Actions</ck-responsive-col-head>
                </ck-responsive-thead>
                <ck-responsive-tbody>
                    @foreach (var secret in Model.Client.Secrets)
                    {
                        var isLast = Model.Client.RequireClientSecret && Model.Client.Secrets.Count <= 1;
                        <ck-responsive-row>
                            <ck-responsive-col>@(string.IsNullOrWhiteSpace(secret.Description) ? "—" : secret.Description)</ck-responsive-col>
                            <ck-responsive-col>@secret.Created.ToString("yyyy-MM-dd HH:mm") UTC</ck-responsive-col>
                            <ck-responsive-col>@(secret.Expiration.HasValue ? secret.Expiration.Value.ToString("yyyy-MM-dd") : "Never")</ck-responsive-col>
                            <ck-responsive-col class="actions-cell">
                                <button
                                    type="button"
                                    class="action-link action-link-danger"
                                    data-action="revoke-secret"
                                    data-secret-id="@secret.Id"
                                    data-secret-description="@(string.IsNullOrWhiteSpace(secret.Description) ? "this secret" : secret.Description)"
                                    disabled="@isLast"
                                    title="@(isLast ? "This is the last secret on a confidential client and cannot be revoked. Generate a replacement secret first." : null)">
                                    Revoke
                                </button>
                            </ck-responsive-col>
                        </ck-responsive-row>
                    }
                </ck-responsive-tbody>
            </ck-responsive-table>
        }
    </ck-tab>
    <ck-tab label="Generate New Secret">
        <form method="post" asp-page-handler="Generate">
            <div class="form-group" style="margin-bottom: 16px; max-width: 450px;">
                <label class="form-label" for="Description">Description (optional)</label>
                <input asp-for="Description" class="form-control" placeholder="e.g. Rotated 2026 Q1"/>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group" style="margin-bottom: 24px; max-width: 450px;">
                <label class="form-label" for="Expiration">Expiration (optional)</label>
                <input asp-for="Expiration" class="form-control" type="date"/>
                <span asp-validation-for="Expiration" class="text-danger"></span>
            </div>
            <button type="submit" class="btn-primary">Generate Secret</button>
        </form>
    </ck-tab>
</ck-tabs>

<dialog id="revoke-secret-modal" class="modal">
    <form method="post" asp-page-handler="Revoke">
        <input type="hidden" name="secretId" id="revoke-secret-modal-id-input" value=""/>

        <h2 class="modal-title">Revoke client secret</h2>

        <p class="modal-body" id="revoke-secret-modal-message">
            Are you sure you want to revoke <strong id="revoke-secret-modal-description-text"></strong>? Any tokens
            issued using this secret will continue to work until they expire, but the secret can no longer be used
            to authenticate. This cannot be undone.
        </p>

        <div class="modal-actions">
            <button type="button" class="btn-secondary" data-action="close-modal">Cancel</button>
            <button type="submit" id="revoke-secret-modal-confirm" class="btn-danger">Revoke</button>
        </div>
    </form>
</dialog>

<style>
    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--ink, #17191c);
    }

    .form-control {
        width: 100%;
        border: 1px solid var(--border, #e6e8eb);
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 0.9rem;
    }
</style>

@section Scripts {
    <script>
        function copySecretToClipboard() {
            const input = document.getElementById('generated-secret-input');
            if (!input) return;

            input.select();
            navigator.clipboard.writeText(input.value).then(() => {
                const btn = document.getElementById('copy-secret-btn');
                if (btn) {
                    const origText = btn.textContent;
                    btn.textContent = '✓ Copied!';
                    setTimeout(() => {
                        btn.textContent = origText;
                    }, 2000);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById('revoke-secret-modal');
            const idInput = document.getElementById('revoke-secret-modal-id-input');
            const descriptionText = document.getElementById('revoke-secret-modal-description-text');

            document.querySelectorAll('[data-action="revoke-secret"]').forEach(btn => {
                btn.addEventListener('click', function () {
                    const secretId = this.getAttribute('data-secret-id');
                    const description = this.getAttribute('data-secret-description');

                    idInput.value = secretId;
                    descriptionText.textContent = description;

                    if (typeof modal.showModal === 'function') {
                        modal.showModal();
                    }
                });
            });

            document.querySelectorAll('[data-action="close-modal"]').forEach(btn => {
                btn.addEventListener('click', function () {
                    if (typeof modal.close === 'function') {
                        modal.close();
                    }
                });
            });
        });
    </script>
}
