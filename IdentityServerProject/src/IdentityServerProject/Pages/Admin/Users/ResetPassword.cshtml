@page "{id}"
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Admin", "/Admin/Users"),
        ("Users", "/Admin/Users"),
        (Model.UserNameDisplay, $"/Admin/Users/Details/{Model.Id}"),
        ("Reset Password", null)
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">Reset Password</h1>
        <p class="page-sub">Set a new password for @Model.UserNameDisplay.</p>
    </div>
</div>

<form method="post">
    <div asp-validation-summary="All" class="validation-summary alert-panel alert-danger"
         style="display: @(ViewData.ModelState.IsValid ? "none" : "block"); margin-bottom: 20px;"></div>

    <div class="panel" style="padding: 28px;">
        <div class="form-field">
            <label asp-for="Input.NewPassword" class="form-label">New Password</label>
            <input asp-for="Input.NewPassword" type="password" class="form-control" autocomplete="new-password"/>
            <span asp-validation-for="Input.NewPassword" class="text-danger field-validation-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password"/>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger field-validation-error"></span>
        </div>

        <div class="form-actions" style="display: flex; gap: 12px; margin-top: 24px;">
            <button type="submit" class="btn-danger">Reset Password</button>
            <a asp-page="./Details" asp-route-id="@Model.Id" class="btn-secondary">Cancel</a>
        </div>
    </div>
</form>

<style>
    .form-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 20px;
    }

    .form-control {
        width: 100%;
        max-width: 400px;
        border: 1px solid var(--border, #e6e8eb);
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.95rem;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--ink, #17191c);
    }

    .field-validation-error {
        font-size: 0.85rem;
        color: #c8433b;
        margin-top: 2px;
    }
</style>
