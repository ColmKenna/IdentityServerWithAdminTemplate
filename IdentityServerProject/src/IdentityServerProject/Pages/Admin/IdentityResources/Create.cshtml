@page
@model CreateModel
@{
    ViewData["Title"] = "Create Identity Resource";
    ViewData["Breadcrumbs"] = new List<Breadcrumb>
    {
        new("Admin", "/Admin/Index"),
        new("Identity Resources", "/Admin/IdentityResources/Index"),
        new("Create Identity Resource")
    };
}

<page-header title="Create Identity Resource" sub="Add a new OpenID Connect identity resource with optional template quick-fill." variant="editor">
    <partial name="_BackLink" />
</page-header>

<form method="post" id="create-resource-form">
    <div asp-validation-summary="All" role="alert" class="validation-summary"></div>

    <div class="panel editor-panel">
        <h2 class="panel-title">1. Select a Template (Optional)</h2>
        <p class="page-sub">
            Choose a standard OpenID Connect template to pre-populate claims, or create a custom resource.
        </p>

        <div class="preset-grid">
            <button type="button" class="preset-card" data-template="profile" onclick="applyTemplate('profile')">
                <div class="preset-icon">👤</div>
                <div class="preset-title">Profile</div>
                <div class="preset-desc">User profile information (name, picture, etc.)</div>
            </button>

            <button type="button" class="preset-card" data-template="email" onclick="applyTemplate('email')">
                <div class="preset-icon">📧</div>
                <div class="preset-title">Email</div>
                <div class="preset-desc">Email address and verification status</div>
            </button>

            <button type="button" class="preset-card" data-template="address" onclick="applyTemplate('address')">
                <div class="preset-icon">🏠</div>
                <div class="preset-title">Address</div>
                <div class="preset-desc">User address information</div>
            </button>

            <button type="button" class="preset-card" data-template="phone" onclick="applyTemplate('phone')">
                <div class="preset-icon">📞</div>
                <div class="preset-title">Phone</div>
                <div class="preset-desc">Phone number and verification status</div>
            </button>
        </div>
    </div>

    <div class="panel editor-panel">
        <h2 class="panel-title">2. Resource Details</h2>

        <div class="form-field">
            <label class="form-label" for="resource-name">Resource Name *</label>
            <input class="form-control" id="resource-name" asp-for="Input.Name" required aria-describedby="resource-name-error"/>
            <span asp-validation-for="Input.Name" id="resource-name-error" class="field-validation-error"></span>
            <small class="form-text">A unique identifier for this resource (e.g., 'profile', 'email',
                'custom.resource').</small>
        </div>

        <div class="form-field">
            <label class="form-label" for="resource-display-name">Display Name</label>
            <input class="form-control" id="resource-display-name" asp-for="Input.DisplayName" aria-describedby="resource-display-name-error"/>
            <span asp-validation-for="Input.DisplayName" id="resource-display-name-error" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label class="form-label" for="resource-description">Description</label>
            <textarea class="form-control" id="resource-description" rows="3" asp-for="Input.Description" aria-describedby="resource-description-error"></textarea>
            <span asp-validation-for="Input.Description" id="resource-description-error" class="field-validation-error"></span>
        </div>

        <div class="form-group checkbox-grid">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="resource-enabled" asp-for="Input.Enabled"/>
                <label class="form-check-label" for="resource-enabled">Enabled</label>
            </div>

            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="resource-required" asp-for="Input.Required"/>
                <label class="form-check-label" for="resource-required">Required</label>
            </div>

            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="resource-emphasize" asp-for="Input.Emphasize"/>
                <label class="form-check-label" for="resource-emphasize">Emphasize</label>
            </div>

            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="resource-show-discovery"
                       asp-for="Input.ShowInDiscoveryDocument" checked/>
                <label class="form-check-label" for="resource-show-discovery">Show in Discovery</label>
            </div>
        </div>

        <h3 class="section-title">User Claims</h3>
        <div id="claims-container" class="claims-container">
            <div id="no-claims-message" class="page-sub">No claims selected. Choose a template or enter claims manually
                below.
            </div>
            <div id="claims-list" class="claims-list">
                <div class="claims-list-flex">
                    <!-- Claims will be inserted here by JavaScript -->
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Create Resource</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/identity-resource-create.js" asp-append-version="true"></script>
}
