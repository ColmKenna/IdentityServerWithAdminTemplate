@page
@model CreateModel
@{
    ViewData["Title"] = "New Role";
    ViewData["Breadcrumbs"] = new List<Breadcrumb>
    {
        new("Admin", "/Admin/Index"),
        new("Roles", "/Admin/Roles/Index"),
        new("New Role")
    };
}

<page-header title="New Role" sub="Create a new application role">
    <partial name="_BackLink" model='new BackLinkModel("./Index", "Back to Roles")' />
</page-header>

<div class="panel panel-padded" style="max-width: 600px;">
    <form method="post">
        <div asp-validation-summary="ModelOnly" role="alert" class="text-danger field-validation-error"
             style="margin-bottom: 20px;"></div>

        <div class="form-group">
            <label asp-for="Input.Name" class="form-label">Role Name <span class="required">*</span></label>
            <input asp-for="Input.Name" class="form-control" placeholder="e.g. Administrator" required aria-describedby="role-name-error"/>
            <span asp-validation-for="Input.Name" id="role-name-error" class="text-danger field-validation-error"></span>
        </div>

        <div class="form-actions form-actions-spaced">
            <button type="submit" class="btn-primary">Create Role</button>
            <a asp-page="./Index" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>
