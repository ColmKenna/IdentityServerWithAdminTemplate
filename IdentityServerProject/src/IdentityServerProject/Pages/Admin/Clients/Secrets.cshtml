@page "{id}"
@model SecretsModel
@{
    ViewData["Title"] = "Manage Client Secrets";
    ViewData[AdminComponents.ViewDataKey] = AdminComponent.ResponsiveTable | AdminComponent.Tabs;
    ViewData["Breadcrumbs"] = new List<Breadcrumb>
    {
        new("Admin", "/Admin/Index"),
        new("Clients", "/Admin/Clients/Index"),
        new(Model.Client.ClientName, "/Admin/Clients/Details", new Dictionary<string, string> { { "id", Model.Id } }),
        new("Secrets")
    };
}

<page-header title="Manage Client Secrets" sub="List, generate, and revoke credentials this client uses to authenticate.">
    <partial name="_BackLink" model='new BackLinkModel("./Details", "Back to Client", new Dictionary<string, string> { { "id", Model.Id } })' />
</page-header>

@if (Model.RevealMode)
{
    <partial name="_SecretRevealBanner" model='new SecretRevealBannerModel(Model.GeneratedSecret, Model.Id, "A new secret has been generated for <strong><code>{0}</code></strong>. Below is the one-time value.", new[] { Model.Id })' />
}

@if (!string.IsNullOrWhiteSpace(Model.RevokeErrorMessage))
{
    <div class="alert alert-error" role="alert">@Model.RevokeErrorMessage</div>
}

<ck-tabs id="client-secrets-tabs" class="client-editor-tabs">
    <ck-tab label="Active Secrets" active>
        @if (Model.Client.Secrets.Count == 0)
        {
            <div class="empty-state">No secrets registered for this client.</div>
        }
        else
        {
            <ck-responsive-table mobile-breakpoint="768px">
                <ck-responsive-thead>
                    <ck-responsive-col-head>Description</ck-responsive-col-head>
                    <ck-responsive-col-head>Created</ck-responsive-col-head>
                    <ck-responsive-col-head>Expiration</ck-responsive-col-head>
                    <ck-responsive-col-head class="actions-cell">Actions</ck-responsive-col-head>
                </ck-responsive-thead>
                <ck-responsive-tbody>
                    @foreach (var secret in Model.Client.Secrets)
                    {
                        var isLast = Model.Client.RequireClientSecret && Model.Client.Secrets.Count <= 1;
                        <ck-responsive-row>
                            <ck-responsive-col>@(string.IsNullOrWhiteSpace(secret.Description) ? "—" : secret.Description)</ck-responsive-col>
                            <ck-responsive-col>@secret.Created.ToString("yyyy-MM-dd HH:mm") UTC</ck-responsive-col>
                            <ck-responsive-col>@(secret.Expiration.HasValue ? secret.Expiration.Value.ToString("yyyy-MM-dd") : "Never")</ck-responsive-col>
                            <ck-responsive-col class="actions-cell">
                                <button
                                    type="button"
                                    class="action-link action-link-danger"
                                    data-action="revoke-secret"
                                    data-secret-id="@secret.Id"
                                    data-secret-description="@(string.IsNullOrWhiteSpace(secret.Description) ? "this secret" : secret.Description)"
                                    disabled="@isLast">
                                    Revoke
                                </button>
                                @if (isLast)
                                {
                                    <span class="danger-row-desc">Last secret — generate a replacement first</span>
                                }
                            </ck-responsive-col>
                        </ck-responsive-row>
                    }
                </ck-responsive-tbody>
            </ck-responsive-table>
        }
    </ck-tab>
    <ck-tab label="Generate New Secret">
        <form method="post" asp-page-handler="Generate">
            <div class="form-group form-control-md">
                <label class="form-label" for="Description">Description (optional)</label>
                <input asp-for="Description" class="form-control" placeholder="e.g. Rotated 2026 Q1" aria-describedby="secret-description-error"/>
                <span asp-validation-for="Description" id="secret-description-error" class="text-danger"></span>
            </div>
            <div class="form-group form-control-md">
                <label class="form-label" for="Expiration">Expiration (optional)</label>
                <input asp-for="Expiration" class="form-control" type="date" aria-describedby="secret-expiration-error"/>
                <span asp-validation-for="Expiration" id="secret-expiration-error" class="text-danger"></span>
            </div>
            <button type="submit" class="btn-primary">Generate Secret</button>
        </form>
    </ck-tab>
</ck-tabs>

<partial name="_ConfirmationModal" model='new ConfirmationModalModel("revoke-secret-modal", "Revoke client secret", "Revoke", "Are you sure you want to revoke <strong id=\"revoke-secret-modal-description-text\"></strong>? Any tokens issued using this secret will continue to work until they expire, but the secret can no longer be used to authenticate. This cannot be undone.", submitText: "Revoke", submitId: "revoke-secret-modal-confirm", hiddenInputName: "secretId", hiddenInputId: "revoke-secret-id-input", bodyId: "revoke-secret-modal-message")' />

@section Scripts {
    <script src="~/js/client-secrets.js" asp-append-version="true"></script>
}
