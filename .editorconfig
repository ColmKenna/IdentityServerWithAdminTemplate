# Top-most EditorConfig file
root = true

[*.cs]

# ==========================================
# 1. Block and Brace Preferences
# ==========================================
# Prefer no braces for single-line statements (if, while, etc.)
csharp_prefer_braces = false:warning

# ==========================================
# 2. Modern C# Syntax Preferences
# ==========================================
# Prefer file-scoped namespaces (C# 10+)
csharp_style_namespace_declarations = file_scoped:warning

# Target-typed new expressions (C# 9+)
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

# Null checks and coalescing
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning

# Prefer pattern matching over old 'is' checks with casts
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion

# ==========================================
# 3. Expression-Bodied Members (=>)
# ==========================================
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# ==========================================
# 4. 'var' vs. Explicit Type Usage
# ==========================================
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# ==========================================
# 5. Modifiers
# ==========================================
# Require accessibility modifiers explicitly
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Enforce 'readonly' on fields that are only assigned in constructors
dotnet_style_readonly_field = true:warning

# ==========================================
# 6. 'using' Directives & Import Cleanliness
# ==========================================
# Place 'using' directives outside the namespace declaration
csharp_using_directive_placement = outside_namespace:warning

# Sort System.* directives before other namespaces
dotnet_sort_system_directives_first = true:suggestion

# Treat unused using directives as compiler warnings (IDE0005)
dotnet_diagnostic.IDE0005.severity = warning

# ==========================================
# 7. Naming Conventions
# ==========================================
# Interfaces must start with 'I'
dotnet_naming_rule.interface_should_be_prefixed_with_i.symbols = interface_symbols
dotnet_naming_rule.interface_should_be_prefixed_with_i.style = prefix_i_style
dotnet_naming_rule.interface_should_be_prefixed_with_i.severity = warning

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

# Private fields must be camelCase (no underscore)
dotnet_naming_rule.private_fields_must_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_must_be_camel_case.style = camel_case_style
dotnet_naming_rule.private_fields_must_be_camel_case.severity = suggestion

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_style.capitalization = camel_case


# ==========================================
# Exclude Migrations and Generated Code
# ==========================================

# Target any file inside a 'Migrations' or 'Generated' folder, anywhere in the project
[**/{Migrations,Generated}/**/*.cs]
generated_code = true