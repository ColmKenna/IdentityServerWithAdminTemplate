@page
@using IdentityServerProject.Services.AuditLogs
@model IdentityServerProject.Pages.Admin.AuditLogs.IndexModel
@{
    ViewData["Title"] = "Audit Log";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Audit Log</h1>
        <p class="page-sub">Searchable, read-only history of administrative actions</p>
    </div>
</div>

<div class="panel">
    <form method="get" class="list-filter" role="search">
        <div class="filter-grid">
            <div>
                <label asp-for="Filter.ActorSubjectId">Actor subject ID</label>
                <input asp-for="Filter.ActorSubjectId" class="form-control" type="search" placeholder="Contains…" />
            </div>
            <div>
                <label asp-for="Filter.TargetId">Target ID</label>
                <input asp-for="Filter.TargetId" class="form-control" type="search" placeholder="Contains…" />
            </div>
            <div>
                <label asp-for="Filter.Category">Category</label>
                <input asp-for="Filter.Category" class="form-control" type="search" placeholder="Exact match" />
            </div>
            <div>
                <label asp-for="Filter.Action">Action</label>
                <input asp-for="Filter.Action" class="form-control" type="search" placeholder="Exact match" />
            </div>
            <div>
                <label asp-for="Filter.Outcome">Outcome</label>
                <select asp-for="Filter.Outcome" class="form-control">
                    <option value="">All outcomes</option>
                    <option value="Succeeded">Succeeded</option>
                    <option value="Denied">Denied</option>
                    <option value="Failed">Failed</option>
                </select>
            </div>
            <div>
                <label asp-for="Filter.CorrelationId">Correlation ID</label>
                <input asp-for="Filter.CorrelationId" class="form-control" type="search" placeholder="Exact match" />
            </div>
        </div>
        <div class="filter-actions">
            <button type="submit" class="btn-secondary">Filter</button>
            <a asp-page="./Index" class="btn-tertiary">Clear</a>
        </div>
    </form>

    <ck-responsive-table class="audit-log-table" mobile-breakpoint="768px">
        <ck-responsive-thead>
            <ck-responsive-col-head>Actor</ck-responsive-col-head>
            <ck-responsive-col-head>Action</ck-responsive-col-head>
            <ck-responsive-col-head>Target</ck-responsive-col-head>
            <ck-responsive-col-head>Details</ck-responsive-col-head>
            <ck-responsive-col-head>When</ck-responsive-col-head>
        </ck-responsive-thead>
        <ck-responsive-tbody>
            @foreach (var entry in Model.AuditLogEntries.Items)
            {
                <ck-responsive-row>
                    <ck-responsive-col>@entry.ActorName</ck-responsive-col>
                    <ck-responsive-col>
                        @switch (entry.Outcome)
                        {
                            case AuditOutcome.Succeeded:
                                <span class="status-badge success" title="Succeeded">✓</span>
                                break;
                            case AuditOutcome.Denied:
                                <span class="status-badge warning" title="Denied">⚠</span>
                                break;
                            default:
                                <span class="status-badge failure" title="Failed">✗</span>
                                break;
                        }
                        @entry.Category / @entry.Action
                    </ck-responsive-col>
                    <ck-responsive-col>@(string.IsNullOrWhiteSpace(entry.TargetName) ? "—" : entry.TargetName)</ck-responsive-col>
                    <ck-responsive-col>
                        <div>@(string.IsNullOrWhiteSpace(entry.Details) ? "—" : entry.Details)</div>
                        <details class="audit-metadata">
                            <summary>Metadata</summary>
                            <dl>
                                <dt>Outcome</dt><dd>@entry.Outcome</dd>
                                <dt>Reason</dt><dd>@(entry.ReasonCode ?? "—")</dd>
                                <dt>Actor subject</dt><dd>@(entry.ActorSubjectId ?? "—")</dd>
                                <dt>Target ID</dt><dd>@(entry.TargetId ?? "—")</dd>
                                <dt>Correlation ID</dt><dd>@(entry.CorrelationId ?? "—")</dd>
                                <dt>IP address</dt><dd>@(entry.IpAddress ?? "—")</dd>
                            </dl>
                            @if (!string.IsNullOrWhiteSpace(entry.OldValuesJson))
                            {
                                <h3>Before</h3>
                                <pre>@entry.OldValuesJson</pre>
                            }
                            @if (!string.IsNullOrWhiteSpace(entry.NewValuesJson))
                            {
                                <h3>After</h3>
                                <pre>@entry.NewValuesJson</pre>
                            }
                        </details>
                    </ck-responsive-col>
                    <ck-responsive-col>@entry.Timestamp.ToString("yyyy-MM-dd HH:mm") UTC</ck-responsive-col>
                </ck-responsive-row>
            }
        </ck-responsive-tbody>
    </ck-responsive-table>

    @if (Model.AuditLogEntries.Items.Count == 0)
    {
        <div class="empty-state">No audit log entries found.</div>
    }

    <div class="pagination-footer">
        <span class="pagination-summary">Showing @Model.AuditLogEntries.Items.Count of @Model.AuditLogEntries.TotalCount entries</span>
        <div class="pagination-controls">
            @if (!Model.AuditLogEntries.HasPreviousPage)
            {
                <span data-pagination="previous" class="pagination-btn disabled" aria-disabled="true">&lsaquo;</span>
            }
            else
            {
                <a data-pagination="previous" class="pagination-btn" asp-page="./Index" asp-route-Filter.ActorSubjectId="@Model.Filter.ActorSubjectId" asp-route-Filter.TargetId="@Model.Filter.TargetId" asp-route-Filter.Category="@Model.Filter.Category" asp-route-Filter.Action="@Model.Filter.Action" asp-route-Filter.Outcome="@Model.Filter.Outcome" asp-route-Filter.CorrelationId="@Model.Filter.CorrelationId" asp-route-PageNumber="@(Model.AuditLogEntries.PageNumber - 1)">&lsaquo;</a>
            }
            <span class="pagination-page">Page @Model.AuditLogEntries.PageNumber of @Model.AuditLogEntries.TotalPages</span>
            @if (!Model.AuditLogEntries.HasNextPage)
            {
                <span data-pagination="next" class="pagination-btn disabled" aria-disabled="true">&rsaquo;</span>
            }
            else
            {
                <a data-pagination="next" class="pagination-btn" asp-page="./Index" asp-route-Filter.ActorSubjectId="@Model.Filter.ActorSubjectId" asp-route-Filter.TargetId="@Model.Filter.TargetId" asp-route-Filter.Category="@Model.Filter.Category" asp-route-Filter.Action="@Model.Filter.Action" asp-route-Filter.Outcome="@Model.Filter.Outcome" asp-route-Filter.CorrelationId="@Model.Filter.CorrelationId" asp-route-PageNumber="@(Model.AuditLogEntries.PageNumber + 1)">&rsaquo;</a>
            }
        </div>
    </div>
</div>

<style>
    .audit-metadata { margin-top: 0.4rem; }
    .audit-metadata summary { cursor: pointer; }
    .audit-metadata dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0.25rem 0.75rem; margin: 0.5rem 0; }
    .audit-metadata dt { font-weight: 600; }
    .audit-metadata dd { margin: 0; overflow-wrap: anywhere; }
    .audit-metadata h3 { font-size: 0.9rem; margin: 0.75rem 0 0.25rem; }
    .audit-metadata pre { white-space: pre-wrap; overflow-wrap: anywhere; }
</style>
