@model IdentityServerProject.Pages.Shared.SecretRevealBannerModel

@if (!string.IsNullOrEmpty(Model.SecretValue))
{
    <div id="secret-reveal-banner" class="panel alert-panel alert-success"
         style="border-left: 5px solid #278070; background: #e8f8f5; padding: 20px; margin-bottom: 24px;">
        <h2 style="font-size: 18px; margin-bottom: 8px; color: #16324f;">🔑 Client Secret Generated</h2>
        <p style="margin-bottom: 12px; font-size: 14px;">
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                @Html.Raw(Model.Description)
            }
            else
            {
                <text>Client <strong><code>@Model.ClientId</code></strong> has been created successfully. Below is the one-time client secret.</text>
            }
        </p>
        <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 12px;">
            <input id="generated-secret-input" type="text" class="form-control" value="@Model.SecretValue" readonly
                   style="font-family: monospace; font-size: 16px; font-weight: bold; background: #fff; max-width: 450px;"/>
            <button id="copy-secret-btn" type="button" class="btn-primary" data-copy-target="generated-secret-input" onclick="copySecretToClipboard()">Copy Secret</button>
        </div>
        <p class="text-danger" style="margin: 0; font-weight: 500; font-size: 13px; color: #a94442;">
            ⚠️ <strong>Important:</strong> Copy this secret now. It is stored securely in hashed format and cannot be displayed again!
        </p>
    </div>
}
