@page "{id}"
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    ViewData["Breadcrumbs"] = new List<Breadcrumb>
    {
        new("Admin", "/Admin/Index"),
        new("Users", "/Admin/Users/Index"),
        new(Model.UserNameDisplay, "/Admin/Users/Details", new Dictionary<string, string> { { "id", Model.Id } }),
        new("Reset Password")
    };
}

<page-header title="Reset Password" sub="Set a new password for @Model.UserNameDisplay.">
</page-header>

<form method="post">
    <div asp-validation-summary="All" role="alert" class="validation-summary alert-panel alert-danger"></div>

    <div class="panel panel-padded">
        <div class="form-field">
            <label asp-for="Input.NewPassword" class="form-label">New Password</label>
            <input asp-for="Input.NewPassword" type="password" class="form-control" autocomplete="new-password" aria-describedby="new-password-error"/>
            <span asp-validation-for="Input.NewPassword" id="new-password-error" class="text-danger field-validation-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-describedby="confirm-password-error"/>
            <span asp-validation-for="Input.ConfirmPassword" id="confirm-password-error" class="text-danger field-validation-error"></span>
        </div>

        <div class="form-actions form-actions-spaced">
            <button type="submit" class="btn-danger">Reset Password</button>
            <a asp-page="./Details" asp-route-id="@Model.Id" class="btn-secondary">Cancel</a>
        </div>
    </div>
</form>
