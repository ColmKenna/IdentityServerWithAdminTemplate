@page
@model EditModel
@{
    ViewData["Title"] = Model.Editor.Name;
}

<div class="editor-header">
    <div>
        <h1 class="hero-title">@Model.Editor.Name</h1>
        <p class="page-sub">Manage display name, description, and claims for this API scope.</p>
    </div>
    <partial name="_BackLink" />
</div>

<div class="panel editor-panel">
    <form method="post" asp-page-handler="Save" asp-route-name="@Model.Editor.Name" class="editor-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-field">
            <label class="form-label" for="scope-name">Name</label>
            <input class="form-control" id="scope-name" value="@Model.Editor.Name" disabled/>
            <small class="form-text">The unique identifier for this scope. This cannot be changed.</small>
        </div>

        <div class="form-field">
            <label class="form-label" for="scope-display-name">Display name</label>
            <input class="form-control" id="scope-display-name" asp-for="Input.DisplayName"/>
            <span asp-validation-for="Input.DisplayName" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label class="form-label" for="scope-description">Description</label>
            <textarea class="form-control" id="scope-description" rows="3" asp-for="Input.Description"></textarea>
            <span asp-validation-for="Input.Description" class="field-validation-error"></span>
        </div>

        <div class="form-field form-check">
            <input class="form-check-input" type="checkbox" asp-for="Input.Enabled" id="scope-enabled">
            <label class="form-check-label" for="scope-enabled">
                Enabled
                <small class="d-block text-muted">Determines if this scope can be requested.</small>
            </label>
        </div>

        <div class="form-field form-check">
            <input class="form-check-input" type="checkbox" asp-for="Input.Required" id="scope-required">
            <label class="form-check-label" for="scope-required">
                Required
                <small class="d-block text-muted">Specifies whether the user can de-select the scope on the consent
                    screen.</small>
            </label>
        </div>

        <div class="form-field form-check">
            <input class="form-check-input" type="checkbox" asp-for="Input.Emphasize" id="scope-emphasize">
            <label class="form-check-label" for="scope-emphasize">
                Emphasize
                <small class="d-block text-muted">Specifies whether the consent screen will emphasize this
                    scope.</small>
            </label>
        </div>

        <div class="form-field form-check">
            <input class="form-check-input" type="checkbox" asp-for="Input.ShowInDiscoveryDocument"
                   id="scope-show-in-discovery">
            <label class="form-check-label" for="scope-show-in-discovery">
                Show in Discovery Document
                <small class="d-block text-muted">Specifies whether this scope is shown in the discovery
                    document.</small>
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Save</button>
        </div>
    </form>

    <h2 class="section-title">Claims</h2>

    <partial name="_ScopeChipsRow" model='ScopeChipsRowModel.ForSimpleList(Model.Editor.Claims, "No claims configured.", "RemoveClaim", Model.Editor.Name, "claimType")' />

    <form method="post" asp-page-handler="AddClaim" asp-route-name="@Model.Editor.Name"
          class="editor-form editor-subform">
        <h3 class="section-title">Add a claim type</h3>
        <div class="form-field">
            <label class="form-label" for="new-claim-type">Claim type</label>
            <input class="form-control" id="new-claim-type" name="claimType" required/>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-secondary">Add claim</button>
        </div>
    </form>
</div>
