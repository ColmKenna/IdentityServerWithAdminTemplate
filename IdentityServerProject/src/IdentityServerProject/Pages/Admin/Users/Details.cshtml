@page
@using IdentityServerProject.Services.Validation
@model DetailsModel
@{
    ViewData["Title"] = Model.Account.UserName;
    ViewData[AdminComponents.ViewDataKey] = AdminComponent.Tabs;
    ViewData["Breadcrumbs"] = new List<Breadcrumb>
    {
        new("Admin", "/Admin/Index"),
        new("Users", "/Admin/Users/Index"),
        new(Model.Account.UserName)
    };
}

<page-header title="@(string.IsNullOrWhiteSpace(Model.Account.FullName) ? Model.Account.UserName : Model.Account.FullName)">
    <page-sub><code>@Model.Account.UserName</code> &middot; @(Model.Account.Email ?? "No email")</page-sub>
    <partial name="_BackLink" model='new BackLinkModel("./Index", "Back to Users")' />
</page-header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.WarningMessage))
{
    <div class="alert alert-warning" role="alert">@Model.WarningMessage</div>
}

<ck-tabs id="user-details-tabs" class="user-details-tabs" aria-label="User detail workspace tabs">
    <ck-tab label="Overview" data-tab="overview" active="@(Model.Tab == "overview" ? "active" : null)">
        <div class="panel panel-padded" id="tab-panel-overview">
            <h2 class="panel-title">Account
                Overview</h2>
            <div class="field-group"><span class="field-label">Username:</span> <span
                    class="field-value">@Model.Account.UserName</span></div>
            <div class="field-group"><span class="field-label">Email:</span> <span
                    class="field-value">@(Model.Account.Email ?? "—")</span></div>
            <div class="field-group"><span class="field-label">Full Name:</span> <span
                    class="field-value">@(Model.Account.FullName ?? "—")</span></div>
            <div class="field-group">
                <span class="field-label">Status:</span>
                <span
                    class="status-badge @(Model.Account.IsLockedOut ? "disabled" : "enabled")">@(Model.Account.IsLockedOut ? "Locked Out" : "Active")</span>
            </div>
            <div class="field-group"><span class="field-label">Roles:</span> <span
                    class="field-value">@(Model.Account.AssignedRoles.Count == 0 ? "None" : string.Join(", ", Model.Account.AssignedRoles))</span>
            </div>
            <div class="form-actions user-detail-actions">
                <a asp-page="./ResetPassword" asp-route-id="@Model.Id" class="btn-secondary">Reset Password</a>
                @if (Model.Account.IsLockedOut)
                {
                    <form method="post" asp-page-handler="Unlock" asp-route-id="@Model.Id" class="inline-action-form">
                        <button type="submit" class="btn-secondary">Unlock Account</button>
                    </form>
                }
            </div>
        </div>
    </ck-tab>
    <ck-tab label="Roles" data-tab="roles" active="@(Model.Tab == "roles" ? "active" : null)">
        <div class="panel panel-padded" id="tab-panel-roles">
            <h2 class="panel-title">Assigned
                Roles</h2>

            @if (Model.Account.AssignedRoles.Count == 0)
            {
                <div class="empty-state">No roles assigned.</div>
            }
            else
            {
                <ul class="role-list user-detail-list">
                    @foreach (var role in Model.Account.AssignedRoles)
                    {
                        var lockedRole = Model.Account.IsCurrentUser && role == Config.SysAdminRole;
                        <li class="role-list-item">
                            <span class="role-name">@role</span>
                            <form method="post" asp-page-handler="RemoveRole" asp-route-id="@Model.Id"
                                  asp-route-role="@role">
                                <input type="hidden" name="role" value="@role"/>
                                <button type="submit" class="btn-sm btn-secondary" data-action="remove-role"
                                        data-role="@role" disabled="@lockedRole">
                                    Remove
                                </button>
                                @if (lockedRole)
                                {
                                    <span class="danger-row-desc">You cannot remove your own SysAdmin role</span>
                                }
                            </form>
                        </li>
                    }
                </ul>
            }

            <h3 class="user-detail-subheading">Assign Role</h3>
            <form method="post" asp-page-handler="AddRole" asp-route-id="@Model.Id" class="role-assignment-form">
                <select name="role" class="form-control form-control-grow" aria-label="Select a role to assign">
                    <option value="">-- Select a role --</option>
                    @foreach (var role in Model.UnassignedRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <button type="submit" class="btn-primary">Add</button>
            </form>
        </div>
    </ck-tab>
    <ck-tab label="Claims" data-tab="claims" active="@(Model.Tab == "claims" ? "active" : null)">
        <div class="panel panel-padded" id="tab-panel-claims">
            <h2 class="panel-title">Claims</h2>

            @if (Model.Account.Claims.Count == 0)
            {
                <div class="empty-state">No claims assigned.</div>
            }
            else
            {
                <ul class="claim-list user-detail-list">
                    @foreach (var claim in Model.Account.Claims)
                    {
                        <li class="claim-row user-claim-row" data-reserved="@(claim.IsReserved ? "true" : "false")">
                            <code>@claim.Type</code> = <code>@claim.Value</code>
                            @if (claim.IsReserved)
                            {
                                <span class="badge badge-reserved"
                                      title="This claim type is issued by the framework. A stored claim of this type is copied onto the sign-in principal, so it can grant privilege that the Roles tab cannot see. It should be removed.">Reserved</span>
                            }
                            <form method="post" asp-page-handler="RemoveClaim" asp-route-id="@Model.Id"
                                  class="claim-row-action">
                                <input type="hidden" name="claimType" value="@claim.Type"/>
                                <input type="hidden" name="claimValue" value="@claim.Value"/>
                                <button type="submit" class="btn-sm btn-secondary" data-action="remove-claim">Remove
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            }

            <form method="post" asp-page-handler="AddClaim" asp-route-id="@Model.Id" class="claim-entry-form">
                <input type="text" name="claimType" class="form-control form-control-xs" placeholder="Claim type" aria-label="Claim type"
                       maxlength="@ValidationConstants.MaxClaimTypeLength" required/>
                <input type="text" name="claimValue" class="form-control form-control-xs" placeholder="Claim value" aria-label="Claim value"
                       maxlength="@ValidationConstants.MaxClaimValueLength" required/>
                <button type="submit" class="btn-primary btn-sm">Add Claim</button>
            </form>
            <p class="text-muted user-detail-help" id="claim-type-help">
                Identity and authorization claim types (<code>role</code>, <code>sub</code>, <code>amr</code>,
                <code>idp</code>, and the <code>AspNet.Identity.*</code> and WS-* equivalents) are reserved and
                cannot be added here. Grant roles on the <strong>Roles</strong> tab.
            </p>
        </div>
    </ck-tab>
    <ck-tab label="Access & grants" data-tab="access" active="@(Model.Tab == "access" ? "active" : null)">
        <div class="panel panel-padded" id="tab-panel-access">
            <h2 class="panel-title">Access & Active
                Sessions</h2>
            <p class="text-muted user-detail-description">
                This user has <strong>@Model.Account.PersistedGrantCount</strong> persisted grant(s) (refresh tokens,
                user consents, or reference tokens) in the operational store.
            </p>

            <form method="post" asp-page-handler="RevokeUserAccess" asp-route-id="@Model.Id">
                <button type="submit" class="btn-danger" disabled="@Model.Account.IsCurrentUser">
                    Revoke All Access & End Sessions
                </button>
                @if (Model.Account.IsCurrentUser)
                {
                    <p class="danger-row-desc">You cannot revoke your own session.</p>
                }
            </form>
        </div>
    </ck-tab>
    <ck-tab label="Danger Zone" data-tab="danger" active="@(Model.Tab == "danger" ? "active" : null)">
        <div class="panel panel-padded panel-danger" id="tab-panel-danger">
            <h2 class="panel-title panel-title-danger">Danger
                Zone</h2>

            <div class="danger-section">
                <h3 class="danger-action-heading">Suspend User</h3>
                <p class="text-muted user-detail-description">Suspending a user indefinitely
                    prevents them from authenticating. Active sessions are not immediately killed unless you also revoke
                    access.</p>
                <form method="post" asp-page-handler="Suspend" asp-route-id="@Model.Id">
                    <button type="submit" class="btn-danger-outline"
                            disabled="@(Model.Account.IsCurrentUser || Model.Account.IsLockedOut)">
                        Suspend User
                    </button>
                    @if (Model.Account.IsCurrentUser)
                    {
                        <p class="danger-row-desc">You cannot suspend your own account.</p>
                    }
                    else if (Model.Account.IsLockedOut)
                    {
                        <p class="danger-row-desc">This user is already suspended.</p>
                    }
                </form>
            </div>

            <div>
                <h3 class="danger-action-heading">Delete User</h3>
                <p class="text-muted user-detail-description" id="delete-user-desc">Once you delete a user, there is
                    no going back. Please be certain.</p>
                <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id"
                      onsubmit="return confirmDelete(this);">
                    <div class="delete-confirmation-row">
                        <label for="deleteConfirmInput" class="visually-hidden">Type DELETE to confirm user deletion</label>
                        <input type="text" id="deleteConfirmInput" asp-for="DeleteConfirmation" class="form-control form-control-grow"
                               placeholder="Type DELETE to confirm" aria-describedby="delete-user-desc" required/>
                    </div>
                    <button type="submit" class="btn-danger" disabled="@Model.Account.IsCurrentUser">
                        Delete User
                    </button>
                    @if (Model.Account.IsCurrentUser)
                    {
                        <p class="danger-row-desc">You cannot delete your own account.</p>
                    }
                </form>
            </div>
        </div>
    </ck-tab>
</ck-tabs>

@section Scripts {
    <script src="~/js/tab-query-sync.js" asp-append-version="true"></script>
    <script src="~/js/user-details.js" asp-append-version="true"></script>
}
