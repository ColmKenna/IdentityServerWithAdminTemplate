@page
@model CreateModel
@{
    ViewData["Title"] = "Create Identity Resource";
}

<div class="editor-header">
    <div>
        <h1 class="hero-title">Create Identity Resource</h1>
        <p class="page-sub">Add a new OpenID Connect identity resource with optional template quick-fill.</p>
    </div>
    <a asp-page="./Index" class="back-link">
        <svg class="back-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to list
    </a>
</div>

<form method="post" id="create-resource-form">
    <div asp-validation-summary="All" class="validation-summary"></div>

    <div class="panel editor-panel">
        <h2 class="panel-title">1. Select a Template (Optional)</h2>
        <p class="page-sub">
            Choose a standard OpenID Connect template to pre-populate claims, or create a custom resource.
        </p>

        <div class="preset-grid">
            <div class="preset-card" data-template="profile" onclick="applyTemplate('profile')">
                <div class="preset-icon">👤</div>
                <div class="preset-title">Profile</div>
                <div class="preset-desc">User profile information (name, picture, etc.)</div>
            </div>

            <div class="preset-card" data-template="email" onclick="applyTemplate('email')">
                <div class="preset-icon">📧</div>
                <div class="preset-title">Email</div>
                <div class="preset-desc">Email address and verification status</div>
            </div>

            <div class="preset-card" data-template="address" onclick="applyTemplate('address')">
                <div class="preset-icon">🏠</div>
                <div class="preset-title">Address</div>
                <div class="preset-desc">User address information</div>
            </div>

            <div class="preset-card" data-template="phone" onclick="applyTemplate('phone')">
                <div class="preset-icon">📞</div>
                <div class="preset-title">Phone</div>
                <div class="preset-desc">Phone number and verification status</div>
            </div>
        </div>
    </div>

    <div class="panel editor-panel">
        <h2 class="panel-title">2. Resource Details</h2>

        <div class="form-field">
            <label class="form-label" for="resource-name">Resource Name *</label>
            <input class="form-control" id="resource-name" asp-for="Input.Name"/>
            <span asp-validation-for="Input.Name" class="field-validation-error"></span>
            <small class="form-text">A unique identifier for this resource (e.g., 'profile', 'email',
                'custom.resource').</small>
        </div>

        <div class="form-field">
            <label class="form-label" for="resource-display-name">Display Name</label>
            <input class="form-control" id="resource-display-name" asp-for="Input.DisplayName"/>
            <span asp-validation-for="Input.DisplayName" class="field-validation-error"></span>
        </div>

        <div class="form-field">
            <label class="form-label" for="resource-description">Description</label>
            <textarea class="form-control" id="resource-description" rows="3" asp-for="Input.Description"></textarea>
            <span asp-validation-for="Input.Description" class="field-validation-error"></span>
        </div>

        <div class="form-group checkbox-grid">
            <div class="form-check">
                <input class="form-control" type="checkbox" id="resource-enabled" asp-for="Input.Enabled"/>
                <label class="form-check-label" for="resource-enabled">Enabled</label>
            </div>

            <div class="form-check">
                <input class="form-control" type="checkbox" id="resource-required" asp-for="Input.Required"/>
                <label class="form-check-label" for="resource-required">Required</label>
            </div>

            <div class="form-check">
                <input class="form-control" type="checkbox" id="resource-emphasize" asp-for="Input.Emphasize"/>
                <label class="form-check-label" for="resource-emphasize">Emphasize</label>
            </div>

            <div class="form-check">
                <input class="form-control" type="checkbox" id="resource-show-discovery"
                       asp-for="Input.ShowInDiscoveryDocument" checked/>
                <label class="form-check-label" for="resource-show-discovery">Show in Discovery</label>
            </div>
        </div>

        <h3 class="section-title">User Claims</h3>
        <div id="claims-container" class="claims-container">
            <div id="no-claims-message" class="page-sub">No claims selected. Choose a template or enter claims manually
                below.
            </div>
            <div id="claims-list" style="display: none;">
                <div class="claims-list-flex">
                    <!-- Claims will be inserted here by JavaScript -->
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Create Resource</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/identity-resource-create.js" asp-append-version="true"></script>
}
