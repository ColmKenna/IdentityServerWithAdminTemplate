@page
@model IndexModel
@{
    ViewData["Title"] = "API Resources";
    ViewData["Breadcrumbs"] = new List<(string Text, string? Url)>
    {
        ("Admin", "/Admin/Apis/Index"),
        ("API Resources", null)
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">API Resources</h1>
        <p class="page-sub">Secured web APIs registered with IdentityServer</p>
    </div>
    <a id="new-api-resource-link" class="btn-primary" asp-page="./Editor">
        <svg aria-hidden="true" class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        New API resource
    </a>
</div>

<div class="panel">
    <partial name="_ListFilter" model='new ListFilterModel("apis-filter", "Filter API resources", "Filter by name or display name", Model.Filter)' />

    <ck-responsive-table class="apis-table" mobile-breakpoint="768px">
        <ck-responsive-thead>
            <ck-responsive-col-head>Name</ck-responsive-col-head>
            <ck-responsive-col-head>Display Name</ck-responsive-col-head>
            <ck-responsive-col-head>Scopes</ck-responsive-col-head>
            <ck-responsive-col-head>Status</ck-responsive-col-head>
            <ck-responsive-col-head class="actions-cell">Actions</ck-responsive-col-head>
        </ck-responsive-thead>
        <ck-responsive-tbody>
            @foreach (var apiResource in Model.ApiResources.Items)
            {
                <ck-responsive-row>
                    <ck-responsive-col class="resource-name">
                        <a asp-page="./Editor" asp-route-name="@apiResource.Name"
                           class="resource-title-link"><code>@apiResource.Name</code></a>
                    </ck-responsive-col>
                    <ck-responsive-col>@(string.IsNullOrWhiteSpace(apiResource.DisplayName) ? "—" : apiResource.DisplayName)</ck-responsive-col>
                    <ck-responsive-col><span
                            class="badge">@apiResource.ScopeCount scope@(apiResource.ScopeCount == 1 ? "" : "s")</span>
                    </ck-responsive-col>
                    <ck-responsive-col>
                        <span
                            class="status-badge @(apiResource.Enabled ? "enabled" : "disabled")">@(apiResource.Enabled ? "Enabled" : "Disabled")</span>
                    </ck-responsive-col>
                    <ck-responsive-col class="actions-cell">
                        <a asp-page="./Editor" asp-route-name="@apiResource.Name" class="action-link">Manage &rarr;</a>
                    </ck-responsive-col>
                </ck-responsive-row>
            }
        </ck-responsive-tbody>
    </ck-responsive-table>

    @if (Model.ApiResources.Items.Count == 0)
    {
        <div class="empty-state">No API resources found.</div>
    }

    <partial name="_PaginationFooter" model='Model.ApiResources.ToPagination("resources", Model.Filter)' />
</div>
