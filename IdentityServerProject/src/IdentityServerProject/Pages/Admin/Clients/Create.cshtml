@page
@using System.Text.Json
@model CreateModel
@{
    ViewData["Title"] = "Register New Client";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Register New Client</h1>
        <p class="page-sub">Create a new OAuth 2.0 / OIDC client application using a guided preset</p>
    </div>
    <a asp-page="./Index" class="btn-secondary">&larr; Back to Clients</a>
</div>

@if (Model.RevealMode)
{
    <div id="secret-reveal-banner" class="panel alert-panel alert-success"
         style="border-left: 5px solid #278070; background: #e8f8f5; padding: 20px; margin-bottom: 24px;">
        <h2 style="font-size: 18px; margin-bottom: 8px; color: #16324f;">🔑 Client Secret Generated</h2>
        <p style="margin-bottom: 12px; font-size: 14px;">
            Client <strong><code>@Model.CreatedClientId</code></strong> has been created successfully. Below is the
            one-time client secret.
        </p>
        <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 12px;">
            <input id="generated-secret-input" type="text" class="form-control" value="@Model.CreatedSecret" readonly
                   style="font-family: monospace; font-size: 16px; font-weight: bold; background: #fff; max-width: 450px;"/>
            <button id="copy-secret-btn" type="button" class="btn-primary" onclick="copySecretToClipboard()">Copy
                Secret
            </button>
        </div>
        <p class="text-danger" style="margin: 0; font-weight: 500; font-size: 13px; color: #a94442;">
            ⚠️ <strong>Important:</strong> Copy this secret now. It is stored securely in hashed format and cannot be
            displayed again!
        </p>
    </div>
}

<form method="post" id="create-client-form">
    <div asp-validation-summary="All" class="validation-summary alert-panel alert-danger"
         style="display: @(ViewData.ModelState.IsValid ? "none" : "block"); margin-bottom: 20px;"></div>

    <input type="hidden" asp-for="Input.SelectedPreset" id="selected-preset-input"/>

    <div class="panel" style="margin-bottom: 24px;">
        <h2 class="panel-title" style="font-size: 16px; margin-bottom: 14px;">1. Select Client Preset</h2>

        <div class="preset-grid"
             style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;">
            @foreach (var preset in Model.AvailablePresets)
            {
                <button type="button" class="preset-card @(Model.Input.SelectedPreset == preset.Id ? "active" : "")"
                        data-preset="@preset.Id" onclick="selectPreset('@preset.Id')">
                    <div class="preset-icon">@preset.Icon</div>
                    <div class="preset-title">@preset.Name</div>
                    <div class="preset-desc">@preset.Description</div>
                </button>
            }
        </div>
    </div>

    <div class="panel" style="margin-bottom: 24px;">
        <h2 class="panel-title" style="font-size: 16px; margin-bottom: 14px;">2. Client Information</h2>

        <div class="form-group" style="margin-bottom: 16px;">
            <label asp-for="Input.ClientId" class="form-label">Client ID <span class="required">*</span></label>
            <input asp-for="Input.ClientId" class="form-control" placeholder="e.g. my-web-app" required/>
            <small class="form-text">Unique alphanumeric identifier used in OAuth requests.</small>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label asp-for="Input.ClientName" class="form-label">Client Display Name <span
                    class="required">*</span></label>
            <input asp-for="Input.ClientName" class="form-control" placeholder="e.g. Customer Portal Web" required/>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label asp-for="Input.Description" class="form-label">Description</label>
            <textarea asp-for="Input.Description" class="form-control" rows="2"
                      placeholder="Optional notes about this client application"></textarea>
        </div>
    </div>

    <div class="panel" style="margin-bottom: 24px;">
        <h2 class="panel-title" style="font-size: 16px; margin-bottom: 14px;">3. Authentication & Grant Types</h2>

        <div style="display: flex; gap: 24px; flex-wrap: wrap; margin-bottom: 16px;">
            <label class="checkbox-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="checkbox" asp-for="Input.RequirePkce" id="input-require-pkce"/>
                <span>Require PKCE (Proof Key for Code Exchange)</span>
            </label>

            <label class="checkbox-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="checkbox" asp-for="Input.RequireClientSecret" id="input-require-secret"/>
                <span>Require Client Secret</span>
            </label>
        </div>

        <div style="margin-bottom: 16px;">
            <label class="form-label">Allowed Grant Types</label>
            <div style="display: flex; gap: 16px; flex-wrap: wrap; margin-top: 6px;">
                <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                    <input type="checkbox" name="Input.GrantTypes" value="authorization_code" id="grant-auth-code"
                           @(Model.Input.GrantTypes.Contains("authorization_code") ? "checked" : "")/>
                    <code>authorization_code</code>
                </label>

                <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                    <input type="checkbox" name="Input.GrantTypes" value="client_credentials" id="grant-client-creds"
                           @(Model.Input.GrantTypes.Contains("client_credentials") ? "checked" : "")/>
                    <code>client_credentials</code>
                </label>
            </div>
        </div>
    </div>

    <div id="uri-configuration-section" class="panel" style="margin-bottom: 24px;">
        <h2 class="panel-title" style="font-size: 16px; margin-bottom: 14px;">4. Redirect & CORS URIs</h2>

        <!-- Redirect URIs -->
        <div class="form-group" style="margin-bottom: 20px;">
            <label class="form-label">Redirect URIs</label>
            <div id="redirect-uris-container">
                @if (Model.Input.RedirectUris.Count == 0)
                {
                    <div class="uri-input-row" style="display: flex; gap: 8px; margin-bottom: 8px;">
                        <input type="url" name="Input.RedirectUris" class="form-control"
                               placeholder="https://localhost:5001/signin-oidc"
                               aria-label="Redirect URI"/>
                        <button type="button" class="btn-danger btn-sm" onclick="removeUriRow(this)" aria-label="Remove redirect URI">&times;</button>
                    </div>
                }
                else
                {
                    foreach (var uri in Model.Input.RedirectUris)
                    {
                        <div class="uri-input-row" style="display: flex; gap: 8px; margin-bottom: 8px;">
                            <input type="url" name="Input.RedirectUris" class="form-control" value="@uri"
                                   placeholder="https://localhost:5001/signin-oidc"
                                   aria-label="Redirect URI"/>
                            <button type="button" class="btn-danger btn-sm" onclick="removeUriRow(this)" aria-label="Remove redirect URI">&times;
                            </button>
                        </div>
                    }
                }
            </div>
            <button type="button" class="btn-secondary btn-sm"
                    onclick="addUriRow('redirect-uris-container', 'Input.RedirectUris', 'https://localhost:5001/signin-oidc')">
                + Add Redirect URI
            </button>
        </div>

        <!-- Post Logout Redirect URIs -->
        <div class="form-group" style="margin-bottom: 20px;">
            <label class="form-label">Post-Logout Redirect URIs</label>
            <div id="postlogout-uris-container">
                @if (Model.Input.PostLogoutRedirectUris.Count == 0)
                {
                    <div class="uri-input-row" style="display: flex; gap: 8px; margin-bottom: 8px;">
                        <input type="url" name="Input.PostLogoutRedirectUris" class="form-control"
                               placeholder="https://localhost:5001/signout-callback-oidc"
                               aria-label="Post-logout redirect URI"/>
                        <button type="button" class="btn-danger btn-sm" onclick="removeUriRow(this)" aria-label="Remove post-logout redirect URI">&times;</button>
                    </div>
                }
                else
                {
                    foreach (var uri in Model.Input.PostLogoutRedirectUris)
                    {
                        <div class="uri-input-row" style="display: flex; gap: 8px; margin-bottom: 8px;">
                            <input type="url" name="Input.PostLogoutRedirectUris" class="form-control" value="@uri"
                                   placeholder="https://localhost:5001/signout-callback-oidc"
                                   aria-label="Post-logout redirect URI"/>
                            <button type="button" class="btn-danger btn-sm" onclick="removeUriRow(this)" aria-label="Remove post-logout redirect URI">&times;
                            </button>
                        </div>
                    }
                }
            </div>
            <button type="button" class="btn-secondary btn-sm"
                    onclick="addUriRow('postlogout-uris-container', 'Input.PostLogoutRedirectUris', 'https://localhost:5001/signout-callback-oidc')">
                + Add Post-Logout URI
            </button>
        </div>

        <!-- CORS Origins -->
        <div class="form-group" style="margin-bottom: 10px;">
            <label class="form-label">Allowed CORS Origins</label>
            <div id="cors-origins-container">
                @if (Model.Input.CorsOrigins.Count == 0)
                {
                    <div class="uri-input-row" style="display: flex; gap: 8px; margin-bottom: 8px;">
                        <input type="url" name="Input.CorsOrigins" class="form-control"
                               placeholder="https://localhost:5001"
                               aria-label="Allowed CORS origin"/>
                        <button type="button" class="btn-danger btn-sm" onclick="removeUriRow(this)" aria-label="Remove CORS origin">&times;</button>
                    </div>
                }
                else
                {
                    foreach (var origin in Model.Input.CorsOrigins)
                    {
                        <div class="uri-input-row" style="display: flex; gap: 8px; margin-bottom: 8px;">
                            <input type="url" name="Input.CorsOrigins" class="form-control" value="@origin"
                                   placeholder="https://localhost:5001"
                                   aria-label="Allowed CORS origin"/>
                            <button type="button" class="btn-danger btn-sm" onclick="removeUriRow(this)" aria-label="Remove CORS origin">&times;
                            </button>
                        </div>
                    }
                }
            </div>
            <button type="button" class="btn-secondary btn-sm"
                    onclick="addUriRow('cors-origins-container', 'Input.CorsOrigins', 'https://localhost:5001')">+ Add
                CORS Origin
            </button>
        </div>
    </div>

    <div class="panel" style="margin-bottom: 24px;">
        <h2 class="panel-title" style="font-size: 16px; margin-bottom: 14px;">5. Allowed Scopes</h2>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px;">
            @foreach (var scope in Model.AvailableScopes)
            {
                <label
                    style="display: flex; align-items: center; gap: 8px; padding: 8px; border: 1px solid var(--line-soft, #dde3e8); border-radius: 4px; cursor: pointer;">
                    <input type="checkbox" name="Input.AllowedScopes" value="@scope" class="scope-checkbox"
                           @(Model.Input.AllowedScopes.Contains(scope) ? "checked" : "")/>
                    <code>@scope</code>
                </label>
            }
        </div>
    </div>

    <div style="display: flex; gap: 12px; margin-top: 24px;">
        <button type="submit" class="btn-primary">Register Client</button>
        <a asp-page="./Index" class="btn-secondary">Cancel</a>
    </div>
</form>


@section Scripts {
    <script>
        window.availablePresets = @Html.Raw(JsonSerializer.Serialize(Model.AvailablePresets, CreateModel.PresetJsonOptions));
    </script>
    <script src="~/js/client-uri-rows.js" asp-append-version="true"></script>
    <script src="~/js/client-presets.js" asp-append-version="true"></script>
}
