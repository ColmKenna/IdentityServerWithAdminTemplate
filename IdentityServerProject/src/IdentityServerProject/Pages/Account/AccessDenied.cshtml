@page
@{
    ViewData["Title"] = "Access denied";
    var returnUrl = Request.Query["ReturnUrl"].ToString();
    var hasReturnUrl = !string.IsNullOrWhiteSpace(returnUrl);
}

<div class="auth-card-header">
    <div class="auth-brand">
        <div class="brand-icon">id</div>
        <div class="auth-brand-text">
            <span class="auth-brand-name">IdentityServer</span>
            <span class="auth-brand-sub">ADMIN CONSOLE</span>
        </div>
    </div>
    <h1 class="auth-title">Access denied</h1>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <p>
        You are currently signed in as <strong>@(User.Identity.Name ?? "an authenticated user")</strong>,
        but your account does not have permission to access the administration console.
    </p>

    <div class="access-denied-actions" style="margin-top: 24px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
        <form method="post" asp-page="/Account/Logout" class="inline-action-form" style="display: inline;">
            <button type="submit" class="btn-primary">Log out</button>
        </form>
        @if (hasReturnUrl)
        {
            <a asp-page="/Account/Login" asp-route-returnUrl="@returnUrl" class="btn-secondary">Log in as different user</a>
        }
        else
        {
            <a asp-page="/Account/Login" asp-route-returnUrl="/Admin" class="btn-secondary">Log in as different user</a>
        }
    </div>
}
else
{
    <p>Your account does not have permission to access the administration console.</p>
    <div class="access-denied-actions" style="margin-top: 24px;">
        <a asp-page="/Account/Login" asp-route-returnUrl="@(hasReturnUrl ? returnUrl : "/Admin")" class="btn-primary">Log in</a>
    </div>
}
